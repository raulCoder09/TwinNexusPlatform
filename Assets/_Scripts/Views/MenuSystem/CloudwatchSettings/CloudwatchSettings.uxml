<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Scripts/Views/MenuSystem/CloudwatchSettings/CloudwatchSettings.uss?fileID=7433441132597879392&amp;guid=59380153e980a4fad9309add4baf9e1a&amp;type=3#CloudwatchSettings" />
    <ui:VisualElement name="Body" class="body">
        <ui:VisualElement name="Header" class="header">
            <ui:VisualElement name="MenuPanel" class="menu-panel">
                <ui:Button name="MenuButton" text="Menu" class="menu-button" />
            </ui:VisualElement>
            <ui:VisualElement name="TitlePanel" class="spare-header-panel" style="width: 75%; align-items: center; align-self: center; align-content: center;">
                <ui:Label name="TitleLabel" text="Cloudwatch Settings" class="spare-header-label" style="-unity-font-definition: url(&quot;project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&amp;guid=289b75764e32a4b85b2ee0c973db7173&amp;type=3#VT323-Regular&quot;); font-size: 50px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Main" class="main">
            <ui:VisualElement name="MainLeft" class="main-left">
                <ui:VisualElement name="MainTopRow" class="main-top-row" style="height: 70%;">
                    <ui:VisualElement name="MetricsConfigPanel" class="widget-panel">
                        <ui:VisualElement name="MetricsConfigHeader" class="widget-header">
                            <ui:Label name="MetricsConfigTitle" text="Metrics Configuration" class="widget-title" />
                        </ui:VisualElement>
                        <ui:VisualElement name="MetricsConfigContent" class="widget-content" style="align-items: center;">
                            <ui:Label name="MetricNameLabel" text="Metric Name:" class="recent-activity-item" />
                            <ui:TextField name="MetricNameField" value="Enter metric name" class="device-mode-label" style="width: 50%; color: rgba(0, 0, 0, 0.39);" />
                            <ui:Label name="MetricValueLabel" text="Value:" class="recent-activity-item" />
                            <ui:TextField name="MetricValueField" value="0.0" class="device-mode-label" style="width: 50%; color: rgba(0, 0, 0, 0.39);" />
                            <ui:Label name="MetricUnitLabel" text="Unit:" class="recent-activity-item" />
                            <ui:DropdownField name="MetricUnitField" value="Count" choices="Count,Seconds,Percent,Bytes" class="device-mode-label" style="width: 50%; color: rgba(0, 0, 0, 0.39);" />
                            <ui:Button name="PublishMetricButton" text="Publish Metric" class="device-nav-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="AlarmsConfigPanel" class="widget-panel">
                        <ui:VisualElement name="AlarmsConfigHeader" class="widget-header">
                            <ui:Label name="AlarmsConfigTitle" text="Alarms Configuration" class="widget-title" />
                        </ui:VisualElement>
                        <ui:VisualElement name="AlarmsConfigContent" class="widget-content" style="align-items: center;">
                            <ui:Label name="AlarmNameLabel" text="Alarm Name:" class="recent-activity-item" />
                            <ui:TextField name="AlarmNameField" value="Enter alarm name" class="device-mode-label" style="width: 50%; color: rgba(0, 0, 0, 0.39);" />
                            <ui:Label name="MetricNameLabel" text="Metric Name:" class="recent-activity-item" />
                            <ui:TextField name="MetricNameField" value="Enter metric name" class="device-mode-label" style="color: rgba(0, 0, 0, 0.39); width: 50%;" />
                            <ui:Label name="ThresholdLabel" text="Threshold:" class="recent-activity-item" />
                            <ui:TextField name="ThresholdField" value="30.0" class="device-mode-label" style="width: 50%; color: rgba(0, 0, 0, 0.39);" />
                            <ui:Label name="ComparisonTypeLabel" text="Comparison Type:" class="recent-activity-item" />
                            <ui:DropdownField name="ComparisonTypeField" value="LessThanThreshold" choices="LessThanThreshold,GreaterThanThreshold,LessThanOrEqualToThreshold,GreaterThanOrEqualToThreshold" class="device-mode-label" style="color: rgba(0, 0, 0, 0.39); width: 50%;" />
                            <ui:Button name="CreateAlarmButton" text="Create Alarm" class="device-nav-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="LogsConfigPanel" class="widget-panel system-status-panel">
                        <ui:VisualElement name="LogsConfigHeader" class="widget-header">
                            <ui:Label name="LogsConfigTitle" text="Logs Configuration" class="widget-title" />
                        </ui:VisualElement>
                        <ui:VisualElement name="LogsConfigContent" class="widget-content" style="align-items: center;">
                            <ui:Label name="LogGroupLabel" text="Log Group:" class="recent-activity-item" />
                            <ui:TextField name="LogGroupField" value="/twin-nexus-platform" disabled="true" class="device-mode-label" style="width: 50%; color: rgba(0, 0, 0, 0.39);" />
                            <ui:Label name="LogStreamLabel" text="Log Stream:" class="recent-activity-item" />
                            <ui:TextField name="LogStreamField" value="unity-user-timestamp" disabled="true" class="device-mode-label" style="width: 50%; color: rgba(0, 0, 0, 0.39);" />
                            <ui:Label name="LogMessageLabel" text="Log Message:" class="recent-activity-item" />
                            <ui:TextField name="LogMessageField" value="Enter log message" multiline="true" class="device-mode-label" style="width: 50%; color: rgba(0, 0, 0, 0.39);" />
                            <ui:Button name="SendLogButton" text="Send Log" class="device-nav-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="MainBottomRow" class="main-bottom-row" style="height: 30%;">
                    <ui:VisualElement name="MetricsStatusPanel" class="widget-panel">
                        <ui:VisualElement name="MetricsStatusHeader" class="widget-header">
                            <ui:Label name="MetricsStatusTitle" text="Metrics Status" class="widget-title" />
                        </ui:VisualElement>
                        <ui:VisualElement name="MetricsStatusContent" class="widget-content" style="align-items: center;">
                            <ui:VisualElement name="MetricsList" class="recent-activity-content">
                                <ui:Label name="Metric1" text="TestMetric (Namespace: TwinNexusPlatform)" class="recent-activity-item" />
                            </ui:VisualElement>
                            <ui:Button name="RefreshMetricsButton" text="Refresh Metrics" class="device-nav-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="TestPanel" class="widget-panel">
                        <ui:VisualElement name="TestHeader" class="widget-header">
                            <ui:Label name="TestTitle" text="Test CloudWatch" class="widget-title" />
                        </ui:VisualElement>
                        <ui:VisualElement name="TestContent" class="widget-content" style="flex-direction: row;">
                            <ui:VisualElement style="flex-grow: 1; align-items: center; justify-content: center;">
                                <ui:Button name="TestConnectionButton" text="Test Connectivity" class="device-nav-button" />
                                <ui:Button name="TestAlarmButton" text="Create Test Alarm" class="device-nav-button" />
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-grow: 1; align-items: center; justify-content: center;">
                                <ui:Button name="TestLogButton" text="Send Test Log" class="device-nav-button" style="width: 60%;" />
                                <ui:Button name="EnableDisableServiceButton" text="Enable/Disable Service" class="device-nav-button" style="width: 60%;" />
                                <ui:Label name="TestResult" text="Result: Not tested" class="recent-activity-item" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Footer" class="footer" style="height: 5%;">
            <ui:VisualElement name="SparePanel0" class="footer-panel">
                <ui:Label name="SpareLabel0" class="footer-label" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel1" class="footer-panel">
                <ui:Label name="SpareLabel1" class="footer-label" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel2" class="footer-panel">
                <ui:Label name="SpareLabel2" class="footer-label" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel3" class="footer-panel">
                <ui:Label name="SpareLabel3" class="footer-label" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SubpanelsAndSmokeMaskContainer" class="overlay-container">
            <ui:VisualElement name="CodeRain" class="code-rain" />
            <ui:VisualElement name="Scrim" class="ScrimTransparent" />
            <ui:VisualElement name="NavigationMenuPanel" class="NavigationMenuPanelOutMainScreen">
                <ui:VisualElement name="NavigationMenu" class="navigation-menu">
                    <ui:VisualElement class="nav-menu-header">
                        <ui:VisualElement class="nav-username-container">
                            <ui:Label text="Main Menu" class="nav-username" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="nav-menu-content">
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Dashboard" class="nav-button nav-button-active" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement name="TrainingButton" class="nav-button-container">
                                <ui:Button name="TrainingButton" text="Training" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Operations" name="OperationsButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Reports" name="ReportsButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Support" name="SupportButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Settings" name="SettingsButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Logout" name="LogoutButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-spacer-left" />
                            <ui:VisualElement class="nav-spacer-right">
                                <ui:Label name="Label" class="nav-spacer-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="HideMenuButton" class="hide-menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
