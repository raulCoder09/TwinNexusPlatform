/* Estilos base existentes */
.ScrimTransparent {
    flex-grow: 1;
    position: relative;
    display: flex;
    background-color: rgba(0, 0, 0, 0.78);
    transition-duration: 1s;
    opacity: 0;
}

.ScrimOpaque {
    background-color: rgba(0, 0, 0, 0.78);
    opacity: 1;
}

.NavigationMenuPanelOutMainScreen {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: row;
    translate: -100% 0;
    transition-duration: 1s;
    transition-timing-function: ease-in-cubic;
}

.NavigationMenuPanelInMainScreen {
    translate: 0% 0;
}

.code-rain {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/_Images/Backgrounds/ekaterina-novitskaya-gLroHoWh_as-unsplash.jpg");
    background-size: 100% 100%;
    background-repeat: repeat;
    opacity: 0.15;
    z-index: -1;
}

/* Body principal */
.body {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    align-self: stretch;
    align-content: stretch;
    background-color: rgb(0, 0, 0);
    background-image: url("project://database/Assets/_Images/Backgrounds/scanlines2.jpg?fileID=2800000&guid=db31ce936e2104caba450d7ddc5ce66f&type=3#scanlines2");
    background-size: 100% 4px;
    background-repeat: repeat-y;
}

/* Header */
.header {
    flex-grow: 1;
    width: 100%;
    height: 10%;
    flex-direction: row;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 255, 0, 0.3);
}

.menu-panel {
    flex-grow: 1;
    width: 25%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.menu-button {
    height: 80%;
    width: 60%;
    background-color: rgba(0, 0, 0, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(3, 255, 0);
    border-right-color: rgb(3, 255, 0);
    border-top-color: rgb(3, 255, 0);
    border-bottom-color: rgb(3, 255, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    color: rgb(0, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 28px;
    -unity-font-style: bold;
    transition-duration: 0.3s;
    transition-property: background-color, border-color, scale;
}

.spare-header-panel {
    flex-grow: 1;
    width: 75%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.spare-header-label {
    color: rgb(255, 255, 255);
    font-size: 50px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    -unity-font-style: bold;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
}

/* Main Content */
.main {
    flex-grow: 1;
    width: 100%;
    height: 80%;
    padding: 20px;
    justify-content: center;
    align-items: center;
}

/* ARSCARA Points Container */
.arscara-points-container {
    width: 95%;
    height: 90%;
    background-color: rgba(0, 0, 0, 0.7);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    padding: 20px;
    flex-direction: column;
}

/* ARSCARA Points Header */
.arscara-points-header {
    width: 100%;
    height: 12%;
    justify-content: center;
    align-items: center;
    margin-bottom: 15px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 255, 0, 0.3);
}

.arscara-points-title {
    color: rgb(0, 255, 0);
    font-size: 45px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    text-shadow: 0 0 10px rgba(0, 255, 0, 0.5);
}

/* Points Management Content */
.points-management-content {
    width: 100%;
    height: 75%;
    flex-direction: row;
}

/* Points List Panel */
.points-list-panel {
    width: 45%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    padding: 15px;
    margin-right: 10px;
    flex-direction: column;
}

.points-list-header {
    width: 100%;
    height: 10%;
    justify-content: center;
    align-items: center;
    margin-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 255, 0, 0.5);
}

.points-list-title {
    color: rgb(255, 255, 255);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}

.points-list-container {
    width: 100%;
    height: 90%;
    flex-direction: column;
}

.point-item {
    width: 100%;
    height: 12%;
    background-color: rgba(0, 0, 0, 0.6);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    margin-bottom: 5px;
    padding: 8px;
    justify-content: center;
    align-items: center;
    transition-duration: 0.3s;
    transition-property: background-color, border-color, scale;
}

.point-item-selected {
    background-color: rgba(0, 255, 0, 0.2);
    border-left-color: rgb(0, 255, 200);
    border-right-color: rgb(0, 255, 200);
    border-top-color: rgb(0, 255, 200);
    border-bottom-color: rgb(0, 255, 200);
}

.point-item-text {
    color: rgb(0, 255, 0);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}

/* Point Details Panel */
.point-details-panel {
    width: 55%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    padding: 15px;
    margin-left: 10px;
    flex-direction: column;
}

.point-details-header {
    width: 100%;
    height: 10%;
    justify-content: center;
    align-items: center;
    margin-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 255, 0, 0.5);
}

.point-details-title {
    color: rgb(255, 255, 255);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}

.point-details-form {
    width: 100%;
    height: 90%;
    flex-direction: column;
    justify-content: space-evenly;
}

.point-detail-row {
    width: 100%;
    height: 15%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.point-detail-label {
    width: 30%;
    height: 100%;
    justify-content: center;
    align-items: flex-end;
}

.point-detail-label-text {
    color: rgb(255, 255, 255);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    margin-right: 15px;
}

.point-detail-input {
    width: 65%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.point-coordinate-field {
    width: 100%;
    height: 80%;
    background-color: rgba(0, 0, 0, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    color: rgb(0, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    -unity-text-align: middle-center;
    font-size: 26px;
    transition-duration: 0.3s;
    transition-property: border-color, background-color;
}

.point-name-field {
    width: 100%;
    height: 80%;
    background-color: rgba(0, 0, 0, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(255, 200, 0);
    border-right-color: rgb(255, 200, 0);
    border-top-color: rgb(255, 200, 0);
    border-bottom-color: rgb(255, 200, 0);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    color: rgb(255, 200, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    -unity-text-align: middle-left;
    font-size: 26px;
    padding-left: 15px;
    padding-right: 15px;
    transition-duration: 0.3s;
    transition-property: border-color, background-color;
}

/* ARSCARA Points Actions */
.arscara-points-actions {
    width: 100%;
    height: 13%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 15px;
}

.points-action-button {
    width: 20%;
    height: 80%;
    background-color: rgba(12, 53, 17, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    color: rgb(0, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 28px;
    -unity-font-style: bold;
    margin-left: 8px;
    margin-right: 8px;
    transition-duration: 0.3s;
    transition-property: background-color, border-color, scale;
}

.points-add-button {
    background-color: rgba(0, 100, 0, 0.8);
    border-left-color: rgb(0, 200, 0);
    border-right-color: rgb(0, 200, 0);
    border-top-color: rgb(0, 200, 0);
    border-bottom-color: rgb(0, 200, 0);
    color: rgb(0, 200, 0);
}

.points-edit-button {
    background-color: rgba(100, 100, 0, 0.8);
    border-left-color: rgb(255, 200, 0);
    border-right-color: rgb(255, 200, 0);
    border-top-color: rgb(255, 200, 0);
    border-bottom-color: rgb(255, 200, 0);
    color: rgb(255, 200, 0);
}

.points-delete-button {
    background-color: rgba(100, 0, 0, 0.8);
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(255, 0, 0);
    border-top-color: rgb(255, 0, 0);
    border-bottom-color: rgb(255, 0, 0);
    color: rgb(255, 0, 0);
}

/* Status Messages */
.points-status-message {
    width: 100%;
    height: 6%;
    justify-content: center;
    align-items: center;
    margin-top: 10px;
}

.points-status-success {
    color: rgb(0, 255, 0);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    text-shadow: 0 0 8px rgba(0, 255, 0, 0.5);
}

.points-status-error {
    color: rgb(255, 0, 0);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    text-shadow: 0 0 8px rgba(255, 0, 0, 0.5);
}

.points-status-warning {
    color: rgb(255, 255, 0);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    text-shadow: 0 0 8px rgba(255, 255, 0, 0.5);
}

/* Footer */
.footer {
    flex-grow: 1;
    width: 100%;
    height: 10%;
    flex-direction: row;
    border-top-width: 2px;
    border-top-color: rgba(0, 255, 0, 0.3);
    padding: 5px;
}

.footer-panel {
    flex-grow: 1;
    width: 25%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.footer-label {
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}

/* Navigation Menu */
.overlay-container {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    opacity: 1;
}

.navigation-menu {
    flex-grow: 1;
    position: relative;
    width: 25%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.95);
    border-right-width: 2px;
    border-right-color: rgb(0, 255, 0);
}

.nav-menu-header {
    flex-grow: 1;
    width: 100%;
    height: 30%;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 255, 0, 0.3);
}

.nav-username-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}

.nav-username {
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    -unity-font-style: bold;
    font-size: 50px;
    color: rgb(0, 255, 0);
    text-shadow: 0 0 10px rgba(0, 255, 0, 0.5);
}

.nav-menu-content {
    flex-grow: 1;
    width: 100%;
    height: 70%;
    padding: 10px;
}

.nav-menu-row {
    flex-grow: 1;
    flex-direction: row;
    margin-bottom: 5px;
}

.nav-button-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.nav-button {
    width: 90%;
    height: 80%;
    font-size: 36px;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    color: rgb(0, 255, 0);
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.5);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgba(0, 255, 0, 0.3);
    border-right-color: rgba(0, 255, 0, 0.3);
    border-top-color: rgba(0, 255, 0, 0.3);
    border-bottom-color: rgba(0, 255, 0, 0.3);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    transition-duration: 0.3s;
    transition-property: background-color, border-color, scale;
}

.nav-button-active {
    color: rgb(255, 172, 51);
    background-color: rgba(255, 172, 51, 0.1);
    border-left-color: rgb(255, 172, 51);
    border-right-color: rgb(255, 172, 51);
    border-top-color: rgb(255, 172, 51);
    border-bottom-color: rgb(255, 172, 51);
    text-shadow: 0 0 8px rgba(255, 172, 51, 0.5);
}

.nav-spacer-left {
    flex-grow: 1;
    width: 20%;
    height: 100%;
}

.nav-spacer-right {
    flex-grow: 1;
    width: 80%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.nav-spacer-label {
    -unity-font-style: bold;
    font-size: 30px;
}

.hide-menu-button {
    width: 75%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}