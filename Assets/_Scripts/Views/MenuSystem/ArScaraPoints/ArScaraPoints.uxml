<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Scripts/Views/MenuSystem/ArScaraPoints/ArScaraPoints.uss?fileID=7433441132597879392&amp;guid=ee67db987e4cb463ba0784b6c55b44b9&amp;type=3#ArScaraPoints" />
    <ui:VisualElement name="Body" class="body">
        <ui:VisualElement name="Header" class="header">
            <ui:VisualElement name="MenuPanel" class="menu-panel" style="width: 20%;">
                <ui:Button name="MenuButton" text="Menu" class="menu-button" />
            </ui:VisualElement>
            <ui:VisualElement name="TitlePanel" class="spare-header-panel" style="width: 20%;">
                <ui:Label name="TitleLabel" text="ARSCARA Points" class="spare-header-label" />
            </ui:VisualElement>
            <ui:VisualElement name="ArscaraPanel" class="header-dropdown-panel" style="width: 30%; justify-content: center;">
                <ui:DropdownField choices="Menu ARSCARA,Control panel,Jog and teach,Points" name="MenuRobotARSCARADropdownField" class="arscara-dropdown" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Main" class="main">
            <ui:VisualElement name="ARSCARAPointsContainer" class="arscara-points-container">
                <ui:VisualElement name="ARSCARAPointsHeader" class="arscara-points-header">
                    <ui:Label name="ARSCARAPointsTitle" text="Robot Points Management" class="arscara-points-title" />
                </ui:VisualElement>
                <ui:VisualElement name="PointsManagementContent" class="points-management-content">
                    <ui:VisualElement name="PointsListPanel" class="points-list-panel">
                        <ui:VisualElement name="PointsListHeader" class="points-list-header">
                            <ui:Label name="PointsListTitle" text="Saved Points" class="points-list-title" />
                        </ui:VisualElement>
                        <ui:VisualElement name="PointsListContainer" class="points-list-container">
                            <ui:VisualElement name="Point1" class="point-item">
                                <ui:Label name="Point1Text" text="P0 - Home" class="point-item-text" />
                            </ui:VisualElement>
                            <ui:VisualElement name="Point2" class="point-item">
                                <ui:Label name="Point2Text" text="P1 - Pick Position" class="point-item-text" />
                            </ui:VisualElement>
                            <ui:VisualElement name="Point3" class="point-item">
                                <ui:Label name="Point3Text" text="P2 - Place Position" class="point-item-text" />
                            </ui:VisualElement>
                            <ui:VisualElement name="Point4" class="point-item">
                                <ui:Label name="Point4Text" text="P3 - Safe Position" class="point-item-text" />
                            </ui:VisualElement>
                            <ui:VisualElement name="Point5" class="point-item">
                                <ui:Label name="Point5Text" text="P4 - Inspection" class="point-item-text" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="PointDetailsPanel" class="point-details-panel">
                        <ui:VisualElement name="PointDetailsHeader" class="point-details-header">
                            <ui:Label name="PointDetailsTitle" text="Point Details" class="point-details-title" />
                        </ui:VisualElement>
                        <ui:VisualElement name="PointDetailsForm" class="point-details-form">
                            <ui:VisualElement name="PointNameRow" class="point-detail-row">
                                <ui:VisualElement name="PointNameLabel" class="point-detail-label">
                                    <ui:Label name="PointNameLabelText" text="Name:" class="point-detail-label-text" />
                                </ui:VisualElement>
                                <ui:VisualElement name="PointNameInput" class="point-detail-input">
                                    <ui:TextField name="PointNameField" placeholder-text="Enter point name" class="point-name-field" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="XCoordinateRow" class="point-detail-row">
                                <ui:VisualElement name="XCoordinateLabel" class="point-detail-label">
                                    <ui:Label name="XCoordinateLabelText" text="X (mm):" class="point-detail-label-text" />
                                </ui:VisualElement>
                                <ui:VisualElement name="XCoordinateInput" class="point-detail-input">
                                    <ui:TextField name="XCoordinateField" placeholder-text="0.00" class="point-coordinate-field" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="YCoordinateRow" class="point-detail-row">
                                <ui:VisualElement name="YCoordinateLabel" class="point-detail-label">
                                    <ui:Label name="YCoordinateLabelText" text="Y (mm):" class="point-detail-label-text" />
                                </ui:VisualElement>
                                <ui:VisualElement name="YCoordinateInput" class="point-detail-input">
                                    <ui:TextField name="YCoordinateField" placeholder-text="0.00" class="point-coordinate-field" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="ZCoordinateRow" class="point-detail-row">
                                <ui:VisualElement name="ZCoordinateLabel" class="point-detail-label">
                                    <ui:Label name="ZCoordinateLabelText" text="Z (mm):" class="point-detail-label-text" />
                                </ui:VisualElement>
                                <ui:VisualElement name="ZCoordinateInput" class="point-detail-input">
                                    <ui:TextField name="ZCoordinateField" placeholder-text="0.00" class="point-coordinate-field" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="UCoordinateRow" class="point-detail-row">
                                <ui:VisualElement name="UCoordinateLabel" class="point-detail-label">
                                    <ui:Label name="UCoordinateLabelText" text="U (deg):" class="point-detail-label-text" />
                                </ui:VisualElement>
                                <ui:VisualElement name="UCoordinateInput" class="point-detail-input">
                                    <ui:TextField name="UCoordinateField" placeholder-text="0.00" class="point-coordinate-field" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="PointsStatusMessage" class="points-status-message">
                    <ui:Label name="StatusLabel" class="points-status-success" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Footer" class="footer" style="justify-content: center;">
            <ui:VisualElement name="ARSCARAPointsActions" class="arscara-points-actions" style="height: 80%; width: 80%;">
                <ui:Button name="AddPointButton" text="Add Point" class="points-action-button points-add-button" />
                <ui:Button name="EditPointButton" text="Edit Point" class="points-action-button points-edit-button" />
                <ui:Button name="DeletePointButton" text="Delete Point" class="points-action-button points-delete-button" />
                <ui:Button name="GoToPointButton" text="Go To Point" class="points-action-button" />
                <ui:Button name="SaveAllButton" text="Save All" class="points-action-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SubpanelsAndSmokeMaskContainer" class="overlay-container">
            <ui:VisualElement name="CodeRain" class="code-rain" />
            <ui:VisualElement name="Scrim" class="ScrimTransparent" />
            <ui:VisualElement name="NavigationMenuPanel" class="NavigationMenuPanelOutMainScreen">
                <ui:VisualElement name="NavigationMenu" class="navigation-menu">
                    <ui:VisualElement name="NavHeader" class="nav-menu-header">
                        <ui:VisualElement name="NavUsernameContainer" class="nav-username-container">
                            <ui:Label name="NavUsernameLabel" text="Main Menu" class="nav-username" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="NavContent" class="nav-menu-content">
                        <ui:VisualElement name="NavRow1" class="nav-menu-row">
                            <ui:VisualElement name="DashboardContainer" class="nav-button-container">
                                <ui:Button name="DashboardButton" text="Dashboard" class="nav-button nav-button-active" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="NavRow2" class="nav-menu-row">
                            <ui:VisualElement name="TrainingContainer" class="nav-button-container">
                                <ui:Button name="TrainingButton" text="Training" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="NavRow3" class="nav-menu-row">
                            <ui:VisualElement name="OperationsContainer" class="nav-button-container">
                                <ui:Button name="OperationsButton" text="Operations" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="NavRow4" class="nav-menu-row">
                            <ui:VisualElement name="ReportsContainer" class="nav-button-container">
                                <ui:Button name="ReportsButton" text="Reports" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="NavRow5" class="nav-menu-row">
                            <ui:VisualElement name="SupportContainer" class="nav-button-container">
                                <ui:Button name="SupportButton" text="Support" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="NavRow6" class="nav-menu-row">
                            <ui:VisualElement name="SettingsContainer" class="nav-button-container">
                                <ui:Button name="SettingsButton" text="Settings" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="NavRow7" class="nav-menu-row">
                            <ui:VisualElement name="LogoutContainer" class="nav-button-container">
                                <ui:Button name="LogoutButton" text="Logout" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="NavRow8" class="nav-menu-row">
                            <ui:VisualElement name="SpacerLeft" class="nav-spacer-left" />
                            <ui:VisualElement name="SpacerRight" class="nav-spacer-right">
                                <ui:Label name="SpacerLabel" class="nav-spacer-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="HideMenuButton" class="hide-menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
