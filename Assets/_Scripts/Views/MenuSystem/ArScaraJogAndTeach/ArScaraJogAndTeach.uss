/* Estilos base existentes */
.ScrimTransparent {
    flex-grow: 1;
    position: relative;
    display: flex;
    background-color: rgba(0, 0, 0, 0.78);
    transition-duration: 1s;
    opacity: 0;
}

.ScrimOpaque {
    background-color: rgba(0, 0, 0, 0.78);
    opacity: 1;
}

.NavigationMenuPanelOutMainScreen {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: row;
    translate: -100% 0;
    transition-duration: 1s;
    transition-timing-function: ease-in-cubic;
}

.NavigationMenuPanelInMainScreen {
    translate: 0% 0;
}

.code-rain {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/_Images/Backgrounds/ekaterina-novitskaya-gLroHoWh_as-unsplash.jpg");
    background-size: 100% 100%;
    background-repeat: repeat;
    opacity: 0.15;
    z-index: -1;
}

/* Body principal */
.body {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    align-self: stretch;
    align-content: stretch;
    background-color: rgb(0, 0, 0);
    background-image: url("project://database/Assets/_Images/Backgrounds/scanlines2.jpg?fileID=2800000&guid=db31ce936e2104caba450d7ddc5ce66f&type=3#scanlines2");
    background-size: 100% 4px;
    background-repeat: repeat-y;
}

/* Header */
.header {
    flex-grow: 1;
    width: 100%;
    height: 10%;
    flex-direction: row;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 255, 0, 0.3);
}

.header-menu-panel {
    flex-grow: 1;
    width: 20%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.header-title-panel {
    flex-grow: 1;
    width: 20%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.header-dropdown-panel {
    flex-grow: 1;
    width: 30%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.menu-button {
    height: 80%;
    width: 60%;
    background-color: rgba(0, 0, 0, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(3, 255, 0);
    border-right-color: rgb(3, 255, 0);
    border-top-color: rgb(3, 255, 0);
    border-bottom-color: rgb(3, 255, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    color: rgb(0, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 28px;
    -unity-font-style: bold;
    transition-duration: 0.3s;
    transition-property: background-color, border-color, scale;
}

.menu-button:hover {
    background-color: rgba(0, 255, 0, 0.1);
    border-left-color: rgb(0, 255, 150);
    border-right-color: rgb(0, 255, 150);
    border-top-color: rgb(0, 255, 150);
    border-bottom-color: rgb(0, 255, 150);
    scale: 1.05;
}

.menu-button:active {
    scale: 0.95;
    background-color: rgba(0, 255, 0, 0.2);
}

.spare-header-label {
    color: rgb(255, 255, 255);
    font-size: 50px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    -unity-font-style: bold;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
}

/* Dropdown Styles */
.environment-dropdown, .arscara-dropdown {
    width: 80%;
    height: 50%;
    background-color: rgba(0, 0, 0, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    color: rgb(12, 53, 17);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 30px;
    transition-duration: 0.3s;
    transition-property: border-color, background-color;
}

.environment-dropdown:hover, .arscara-dropdown:hover {
    border-left-color: rgb(0, 255, 150);
    border-right-color: rgb(0, 255, 150);
    border-top-color: rgb(0, 255, 150);
    border-bottom-color: rgb(0, 255, 150);
    background-color: rgba(0, 255, 0, 0.05);
}

/* Main Content */
.main {
    flex-grow: 1;
    width: 100%;
    height: 80%;
    flex-direction: row;
    padding: 10px;
}

/* Left Panel - Jog Controls */
.jog-controls-panel {
    flex-grow: 1;
    width: 20%;
    height: 100%;
    margin-right: 10px;
}

.jog-controls-top {
    flex-grow: 1;
    width: 100%;
    height: 33%;
    background-color: rgba(0, 0, 0, 0.6);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    padding: 10px;
    margin-bottom: 10px;
}

.jog-controls-middle {
    flex-grow: 1;
    width: 100%;
    height: 33%;
    background-color: rgba(0, 0, 0, 0.6);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    padding: 10px;
    margin-bottom: 10px;
}

.jog-controls-bottom {
    flex-grow: 1;
    width: 100%;
    height: 33%;
    background-color: rgba(0, 0, 0, 0.6);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    padding: 10px;
}

/* Mode and Speed Dropdown Row */
.mode-speed-row {
    flex-grow: 1;
    flex-direction: row;
}

.mode-dropdown-container, .speed-dropdown-container {
    flex-grow: 1;
    align-items: stretch;
    justify-content: center;
}

.mode-dropdown, .speed-dropdown {
    height: 40%;
    background-color: rgba(0, 0, 0, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    color: rgb(12, 53, 17);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 30px;
    transition-duration: 0.3s;
    transition-property: border-color, background-color;
}

.mode-dropdown:hover, .speed-dropdown:hover {
    border-left-color: rgb(0, 255, 150);
    border-right-color: rgb(0, 255, 150);
    border-top-color: rgb(0, 255, 150);
    border-bottom-color: rgb(0, 255, 150);
    background-color: rgba(0, 255, 0, 0.05);
}

/* Movement Controls Grid */
.movement-controls-grid {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.movement-row {
    flex-grow: 1;
    flex-direction: row;
    width: 100%;
    height: 20%;
    margin-bottom: 2px;
}

.movement-cell {
    flex-grow: 1;
    width: 33%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.movement-cell-center {
    flex-grow: 1;
    width: 33%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

/* Movement Buttons */
.movement-button {
    width: 70%;
    height: 70%;
    background-color: rgba(12, 53, 17, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(3, 255, 0);
    border-right-color: rgb(3, 255, 0);
    border-top-color: rgb(3, 255, 0);
    border-bottom-color: rgb(3, 255, 0);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    color: rgb(3, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 30px;
    -unity-font-style: bold;
    transition-duration: 0.3s;
    transition-property: background-color, border-color, scale;
}

.movement-button:hover {
    background-color: rgba(0, 255, 0, 0.1);
    border-left-color: rgb(0, 255, 150);
    border-right-color: rgb(0, 255, 150);
    border-top-color: rgb(0, 255, 150);
    border-bottom-color: rgb(0, 255, 150);
    scale: 1.05;
}

.movement-button:active {
    scale: 0.95;
    background-color: rgba(0, 255, 0, 0.2);
}

/* Point Name Text Field */
.point-name-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.point-name-field {
    width: 80%;
    height: 40%;
    background-color: rgba(0, 0, 0, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    color: rgb(0, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    -unity-text-align: upper-left;
    font-size: 30px;
    transition-duration: 0.3s;
    transition-property: border-color, background-color;
}

.point-name-field:hover {
    border-left-color: rgb(0, 255, 150);
    border-right-color: rgb(0, 255, 150);
    border-top-color: rgb(0, 255, 150);
    border-bottom-color: rgb(0, 255, 150);
    background-color: rgba(0, 255, 0, 0.05);
}

.point-name-field:focus {
    border-left-color: rgb(0, 255, 200);
    border-right-color: rgb(0, 255, 200);
    border-top-color: rgb(0, 255, 200);
    border-bottom-color: rgb(0, 255, 200);
    background-color: rgba(0, 255, 0, 0.1);
}

/* Center Panel - Empty */
.center-panel {
    flex-grow: 1;
    width: 40%;
    height: 100%;
    margin-left: 10px;
    margin-right: 10px;
}

/* Right Panel - Coordinates and Options */
.coordinates-panel {
    flex-grow: 1;
    width: 40%;
    height: 100%;
    margin-left: 10px;
}

.coordinates-section {
    flex-grow: 1;
    width: 100%;
    height: 33%;
    background-color: rgba(0, 0, 0, 0.6);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    padding: 15px;
    margin-bottom: 10px;
}

.coordinates-display {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-evenly;
}

.coordinate-container {
    flex-grow: 1;
    width: 25%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.coordinate-label {
    color: rgb(3, 255, 0);
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    text-shadow: 0 0 6px rgba(3, 255, 0, 0.5);
}

/* Radio Buttons Section */
.radio-buttons-section {
    flex-grow: 1;
    width: 100%;
    height: 33%;
    background-color: rgba(0, 0, 0, 0.6);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    padding: 15px;
    align-items: flex-end;
    margin-bottom: 10px;
}

.radio-button-container {
    flex-grow: 1;
    width: 100%;
    height: 25%;
}

.radio-button {
    color: rgb(3, 255, 0);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    transition-duration: 0.3s;
    transition-property: color, scale;
}

.radio-button:hover {
    color: rgb(0, 255, 150);
    scale: 1.02;
}

.radio-button:checked {
    color: rgb(0, 255, 200);
    text-shadow: 0 0 8px rgba(0, 255, 200, 0.5);
}

/* Command Section */
.command-section {
    flex-grow: 1;
    width: 100%;
    height: 33%;
    background-color: rgba(0, 0, 0, 0.6);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    padding: 15px;
}

.command-row {
    flex-grow: 1;
    flex-direction: row;
    width: 100%;
    height: 100%;
}

.command-dropdown-container {
    flex-grow: 1;
    width: 50%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.command-dropdown, .destination-dropdown {
    width: 70%;
    height: 40%;
    background-color: rgba(0, 0, 0, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    color: rgb(12, 53, 17);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 30px;
    transition-duration: 0.3s;
    transition-property: border-color, background-color;
}

.command-dropdown:hover, .destination-dropdown:hover {
    border-left-color: rgb(0, 255, 150);
    border-right-color: rgb(0, 255, 150);
    border-top-color: rgb(0, 255, 150);
    border-bottom-color: rgb(0, 255, 150);
    background-color: rgba(0, 255, 0, 0.05);
}

/* Footer */
.footer {
    flex-grow: 1;
    width: 100%;
    height: 10%;
    flex-direction: row;
    border-top-width: 2px;
    border-top-color: rgba(0, 255, 0, 0.3);
    padding: 5px;
}

.footer-left-section {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-evenly;
    width: 20%;
    height: 100%;
    align-items: center;
}

.footer-center-section {
    flex-grow: 1;
    width: 60%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.footer-right-section {
    flex-grow: 1;
    flex-direction: row;
    width: 20%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.footer-button {
    width: 30%;
    height: 80%;
    background-color: rgba(12, 53, 17, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(3, 255, 0);
    border-right-color: rgb(3, 255, 0);
    border-top-color: rgb(3, 255, 0);
    border-bottom-color: rgb(3, 255, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    color: rgb(3, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 30px;
    -unity-font-style: bold;
    transition-duration: 0.3s;
    transition-property: background-color, border-color, scale;
}

.footer-button:hover {
    background-color: rgba(0, 255, 0, 0.1);
    border-left-color: rgb(0, 255, 150);
    border-right-color: rgb(0, 255, 150);
    border-top-color: rgb(0, 255, 150);
    border-bottom-color: rgb(0, 255, 150);
    scale: 1.02;
}

.footer-button:active {
    scale: 0.98;
    background-color: rgba(0, 255, 0, 0.2);
}

.footer-execute-button {
    width: 50%;
    height: 80%;
    background-color: rgba(12, 53, 17, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(3, 255, 0);
    border-right-color: rgb(3, 255, 0);
    border-top-color: rgb(3, 255, 0);
    border-bottom-color: rgb(3, 255, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    color: rgb(3, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 30px;
    -unity-font-style: bold;
    transition-duration: 0.3s;
    transition-property: background-color, border-color, scale;
}

.footer-execute-button:hover {
    background-color: rgba(0, 255, 0, 0.1);
    border-left-color: rgb(0, 255, 150);
    border-right-color: rgb(0, 255, 150);
    border-top-color: rgb(0, 255, 150);
    border-bottom-color: rgb(0, 255, 150);
    scale: 1.02;
}

.footer-execute-button:active {
    scale: 0.98;
    background-color: rgba(0, 255, 0, 0.2);
}

.views-dropdown {
    width: 25%;
    height: 50%;
    background-color: rgba(0, 0, 0, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    color: rgb(12, 53, 17);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 30px;
    transition-duration: 0.3s;
    transition-property: border-color, background-color;
}

.views-dropdown:hover {
    border-left-color: rgb(0, 255, 150);
    border-right-color: rgb(0, 255, 150);
    border-top-color: rgb(0, 255, 150);
    border-bottom-color: rgb(0, 255, 150);
    background-color: rgba(0, 255, 0, 0.05);
}

/* Navigation Menu */
.overlay-container {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    opacity: 1;
}

.navigation-menu {
    flex-grow: 1;
    position: relative;
    width: 25%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.95);
    border-right-width: 2px;
    border-right-color: rgb(0, 255, 0);
}

.nav-menu-header {
    flex-grow: 1;
    width: 100%;
    height: 30%;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 255, 0, 0.3);
}

.nav-username-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}

.nav-username {
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    -unity-font-style: bold;
    font-size: 50px;
    color: rgb(0, 255, 0);
    text-shadow: 0 0 10px rgba(0, 255, 0, 0.5);
}

.nav-menu-content {
    flex-grow: 1;
    width: 100%;
    height: 70%;
    padding: 10px;
}

.nav-menu-row {
    flex-grow: 1;
    flex-direction: row;
    margin-bottom: 5px;
}

.nav-button-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.nav-button {
    width: 90%;
    height: 80%;
    font-size: 36px;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    color: rgb(0, 255, 0);
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.5);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgba(0, 255, 0, 0.3);
    border-right-color: rgba(0, 255, 0, 0.3);
    border-top-color: rgba(0, 255, 0, 0.3);
    border-bottom-color: rgba(0, 255, 0, 0.3);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    transition-duration: 0.3s;
    transition-property: background-color, border-color, scale;
}

.nav-button:hover {
    background-color: rgba(0, 255, 0, 0.1);
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    scale: 1.02;
}

.nav-button-active {
    color: rgb(255, 172, 51);
    background-color: rgba(255, 172, 51, 0.1);
    border-left-color: rgb(255, 172, 51);
    border-right-color: rgb(255, 172, 51);
    border-top-color: rgb(255, 172, 51);
    border-bottom-color: rgb(255, 172, 51);
    text-shadow: 0 0 8px rgba(255, 172, 51, 0.5);
}

.nav-spacer-left {
    flex-grow: 1;
    width: 20%;
    height: 100%;
}

.nav-spacer-right {
    flex-grow: 1;
    width: 80%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.nav-spacer-label {
    -unity-font-style: bold;
    font-size: 30px;
}

.hide-menu-button {
    width: 75%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}