<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Scripts/Views/MenuSystem/ArScaraJogAndTeach/ArScaraJogAndTeach.uss?fileID=7433441132597879392&amp;guid=3b9b1ff6745f34de8be742fd78b17de2&amp;type=3#ArScaraJogAndTeach" />
    
    <ui:VisualElement name="Body" class="body">
        <!-- Header -->
        <ui:VisualElement name="Header" class="header">
            <ui:VisualElement name="MenuPanel" class="header-menu-panel">
                <ui:Button name="MenuButton" text="Menu" class="menu-button" />
            </ui:VisualElement>
            
            <ui:VisualElement name="TitlePanel" class="header-title-panel">
                <ui:Label name="TitleLabel" text="ARSCARA Jog And Teach" class="spare-header-label" />
            </ui:VisualElement>
            
            <ui:VisualElement name="EnvironmentPanel" class="header-dropdown-panel">
                <ui:DropdownField 
                    choices="Menu environment,Virtual  environment,Augmented reality environment,Hybrid environment,Real device environment" 
                    name="MenuEnvironmentDropdownField" 
                    class="environment-dropdown" />
            </ui:VisualElement>
            
            <ui:VisualElement name="ArscaraPanel" class="header-dropdown-panel">
                <ui:DropdownField 
                    choices="Menu ARSCARA,Control panel,Jog and teach,Points" 
                    name="MenuRobotARSCARADropdownField" 
                    class="arscara-dropdown" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Main Content -->
        <ui:VisualElement name="Main" class="main">
            <!-- Left Panel - Jog Controls -->
            <ui:VisualElement name="JogControlsPanel" class="jog-controls-panel">
                <!-- Top Section: Mode and Speed -->
                <ui:VisualElement name="JogControlsTop" class="jog-controls-top">
                    <ui:VisualElement name="ModeSpeedRow" class="mode-speed-row">
                        <ui:VisualElement name="ModeContainer" class="mode-dropdown-container">
                            <ui:DropdownField 
                                choices="Mode,World" 
                                name="ModeDropdown" 
                                class="mode-dropdown" />
                        </ui:VisualElement>
                        <ui:VisualElement name="SpeedContainer" class="speed-dropdown-container">
                            <ui:DropdownField 
                                choices="Speed,Low,Medium,High" 
                                name="SpeedDropdown" 
                                class="speed-dropdown" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Middle Section: Movement Controls -->
                <ui:VisualElement name="JogControlsMiddle" class="jog-controls-middle">
                    <ui:VisualElement name="MovementGrid" class="movement-controls-grid">
                        <!-- Row 1: +Y -->
                        <ui:VisualElement name="MovementRow1" class="movement-row">
                            <ui:VisualElement name="Cell1" class="movement-cell" />
                            <ui:VisualElement name="Cell2" class="movement-cell-center">
                                <ui:Button name="PlusYButton" text="+Y" class="movement-button" />
                            </ui:VisualElement>
                            <ui:VisualElement name="Cell3" class="movement-cell" />
                        </ui:VisualElement>

                        <!-- Row 2: -X, +X -->
                        <ui:VisualElement name="MovementRow2" class="movement-row">
                            <ui:VisualElement name="Cell4" class="movement-cell">
                                <ui:Button name="MinusXButton" text="-X" class="movement-button" />
                            </ui:VisualElement>
                            <ui:VisualElement name="Cell5" class="movement-cell" />
                            <ui:VisualElement name="Cell6" class="movement-cell">
                                <ui:Button name="PlusXButton" text="+X" class="movement-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Row 3: -Y -->
                        <ui:VisualElement name="MovementRow3" class="movement-row">
                            <ui:VisualElement name="Cell7" class="movement-cell" />
                            <ui:VisualElement name="Cell8" class="movement-cell-center">
                                <ui:Button name="MinusYButton" text="-Y" class="movement-button" />
                            </ui:VisualElement>
                            <ui:VisualElement name="Cell9" class="movement-cell" />
                        </ui:VisualElement>

                        <!-- Row 4: +Z -->
                        <ui:VisualElement name="MovementRow4" class="movement-row">
                            <ui:VisualElement name="Cell10" class="movement-cell" />
                            <ui:VisualElement name="Cell11" class="movement-cell-center">
                                <ui:Button name="PlusZButton" text="+Z" class="movement-button" />
                            </ui:VisualElement>
                            <ui:VisualElement name="Cell12" class="movement-cell" />
                        </ui:VisualElement>

                        <!-- Row 5: -U, -Z, +U -->
                        <ui:VisualElement name="MovementRow5" class="movement-row">
                            <ui:VisualElement name="Cell13" class="movement-cell">
                                <ui:Button name="MinusUButton" text="-U" class="movement-button" />
                            </ui:VisualElement>
                            <ui:VisualElement name="Cell14" class="movement-cell-center">
                                <ui:Button name="MinusZButton" text="-Z" class="movement-button" />
                            </ui:VisualElement>
                            <ui:VisualElement name="Cell15" class="movement-cell">
                                <ui:Button name="PlusUButton" text="+U" class="movement-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Bottom Section: Point Name -->
                <ui:VisualElement name="JogControlsBottom" class="jog-controls-bottom">
                    <ui:VisualElement name="PointNameContainer" class="point-name-container">
                        <ui:TextField 
                            name="PointNameField" 
                            placeholder-text="Point name" 
                            class="point-name-field" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Center Panel - Empty -->
            <ui:VisualElement name="CenterPanel" class="center-panel" />

            <!-- Right Panel - Coordinates and Options -->
            <ui:VisualElement name="CoordinatesPanel" class="coordinates-panel">
                <!-- Coordinates Display -->
                <ui:VisualElement name="CoordinatesSection" class="coordinates-section">
                    <ui:VisualElement name="CoordinatesDisplay" class="coordinates-display">
                        <ui:VisualElement name="XCoordinate" class="coordinate-container">
                            <ui:Label name="XLabel" text="X = 00.00 mm" class="coordinate-label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="YCoordinate" class="coordinate-container">
                            <ui:Label name="YLabel" text="Y = 00.00 mm" class="coordinate-label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="ZCoordinate" class="coordinate-container">
                            <ui:Label name="ZLabel" text="Z = 00.00 mm" class="coordinate-label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="UCoordinate" class="coordinate-container">
                            <ui:Label name="ULabel" text="U = 00.00 deg" class="coordinate-label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Radio Buttons Section -->
                <ui:VisualElement name="RadioButtonsSection" class="radio-buttons-section">
                    <ui:VisualElement name="ContinuousContainer" class="radio-button-container">
                        <ui:RadioButton name="ContinuousRadio" label="Continuous" class="radio-button" />
                    </ui:VisualElement>
                    <ui:VisualElement name="LongContainer" class="radio-button-container">
                        <ui:RadioButton name="LongRadio" label="Long" class="radio-button" />
                    </ui:VisualElement>
                    <ui:VisualElement name="MediumContainer" class="radio-button-container">
                        <ui:RadioButton name="MediumRadio" label="Medium" class="radio-button" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ShortContainer" class="radio-button-container">
                        <ui:RadioButton name="ShortRadio" label="Short" class="radio-button" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Command Section -->
                <ui:VisualElement name="CommandSection" class="command-section">
                    <ui:VisualElement name="CommandRow" class="command-row">
                        <ui:VisualElement name="CommandContainer" class="command-dropdown-container">
                            <ui:DropdownField 
                                choices="Command,Go" 
                                name="CommandDropdown" 
                                class="command-dropdown" />
                        </ui:VisualElement>
                        <ui:VisualElement name="DestinationContainer" class="command-dropdown-container">
                            <ui:DropdownField 
                                choices="Destination,P0-Home" 
                                name="DestinationDropdown" 
                                class="destination-dropdown" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Footer -->
        <ui:VisualElement name="Footer" class="footer">
            <ui:VisualElement name="FooterLeftSection" class="footer-left-section">
                <ui:Button name="TeachButton" text="Teach" class="footer-button" />
                <ui:Button name="EditButton" text="Edit" class="footer-button" />
            </ui:VisualElement>
            
            <ui:VisualElement name="FooterCenterSection" class="footer-center-section">
                <ui:DropdownField 
                    choices="Select view,Top,Front,Back,Left,Right" 
                    name="Views" 
                    class="views-dropdown" />
            </ui:VisualElement>
            
            <ui:VisualElement name="FooterRightSection" class="footer-right-section">
                <ui:Button name="ExecuteButton" text="Execute" class="footer-execute-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Overlay and Navigation Menu -->
        <ui:VisualElement name="SubpanelsAndSmokeMaskContainer" class="overlay-container">
            <ui:VisualElement name="CodeRain" class="code-rain" />
            <ui:VisualElement name="Scrim" class="ScrimTransparent" />
            
            <ui:VisualElement name="NavigationMenuPanel" class="NavigationMenuPanelOutMainScreen">
                <ui:VisualElement name="NavigationMenu" class="navigation-menu">
                    <ui:VisualElement name="NavHeader" class="nav-menu-header">
                        <ui:VisualElement name="NavUsernameContainer" class="nav-username-container">
                            <ui:Label name="NavUsernameLabel" text="Main Menu" class="nav-username" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    
                    <ui:VisualElement name="NavContent" class="nav-menu-content">
                        <ui:VisualElement name="NavRow1" class="nav-menu-row">
                            <ui:VisualElement name="DashboardContainer" class="nav-button-container">
                                <ui:Button name="DashboardButton" text="Dashboard" class="nav-button nav-button-active" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        
                        <ui:VisualElement name="NavRow2" class="nav-menu-row">
                            <ui:VisualElement name="TrainingContainer" class="nav-button-container">
                                <ui:Button name="TrainingButton" text="Training" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        
                        <ui:VisualElement name="NavRow3" class="nav-menu-row">
                            <ui:VisualElement name="OperationsContainer" class="nav-button-container">
                                <ui:Button name="OperationsButton" text="Operations" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        
                        <ui:VisualElement name="NavRow4" class="nav-menu-row">
                            <ui:VisualElement name="ReportsContainer" class="nav-button-container">
                                <ui:Button name="ReportsButton" text="Reports" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        
                        <ui:VisualElement name="NavRow5" class="nav-menu-row">
                            <ui:VisualElement name="SupportContainer" class="nav-button-container">
                                <ui:Button name="SupportButton" text="Support" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        
                        <ui:VisualElement name="NavRow6" class="nav-menu-row">
                            <ui:VisualElement name="SettingsContainer" class="nav-button-container">
                                <ui:Button name="SettingsButton" text="Settings" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        
                        <ui:VisualElement name="NavRow7" class="nav-menu-row">
                            <ui:VisualElement name="LogoutContainer" class="nav-button-container">
                                <ui:Button name="LogoutButton" text="Logout" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        
                        <ui:VisualElement name="NavRow8" class="nav-menu-row">
                            <ui:VisualElement name="SpacerLeft" class="nav-spacer-left" />
                            <ui:VisualElement name="SpacerRight" class="nav-spacer-right">
                                <ui:Label name="SpacerLabel" class="nav-spacer-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                
                <ui:Button name="HideMenuButton" class="hide-menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>