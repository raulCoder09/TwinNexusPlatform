<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Scripts/Views/MenuSystem/ArScaraControlPanel/ArScaraControlPanel.uss?fileID=7433441132597879392&amp;guid=d02e5a9693f0b4de0987a273a99ffcee&amp;type=3#ArScaraControlPanel" />
    <ui:VisualElement name="Body" class="body">
        <ui:VisualElement name="Header" class="header">
            <ui:VisualElement name="MenuPanel" class="header-menu-panel">
                <ui:Button name="MenuButton" text="Menu" class="menu-button" />
            </ui:VisualElement>
            <ui:VisualElement name="TitlePanel" class="header-title-panel">
                <ui:Label name="TitleLabel" text="ARSCARA Control Panel" class="spare-header-label" />
            </ui:VisualElement>
            <ui:VisualElement name="EnvironmentPanel" class="header-dropdown-panel">
                <ui:DropdownField choices="Menu environment,Virtual  environment,Augmented reality environment,Hybrid environment,Real device environment" name="MenuEnvironmentDropdownField" class="environment-dropdown" />
            </ui:VisualElement>
            <ui:VisualElement name="ArscaraPanel" class="header-dropdown-panel">
                <ui:DropdownField choices="Menu ARSCARA,Control panel,Jog and teach,Points" name="MenuRobotARSCARADropdownField" class="arscara-dropdown" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Main" class="main">
            <ui:VisualElement name="LeftPanel" class="main-left-section" style="width: 30%;">
                <ui:VisualElement name="EmptySection1" class="empty-section-33" />
                <ui:VisualElement name="MotorControlsSection" class="motor-controls-container">
                    <ui:VisualElement name="MotorControlsInner" class="motor-controls-inner">
                        <ui:VisualElement name="MotorRow1" class="motor-row-1">
                            <ui:Button name="MotorsOffButton" text="Motors off" class="motor-button-off" />
                            <ui:Button name="MotorsOnButton" text="Motors on" class="motor-button-on" />
                        </ui:VisualElement>
                        <ui:VisualElement name="MotorRow2" class="motor-row-2">
                            <ui:Button name="PowerLowButton" text="Power low" class="power-button-low" />
                            <ui:Button name="PowerHighButton" text="Power high" class="power-button-high" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="EmptySection2" class="empty-section-33" />
            </ui:VisualElement>
            <ui:VisualElement name="CenterPanel" class="main-center-section" style="width: 50%;" />
            <ui:VisualElement name="RightPanel" class="main-right-section" style="width: 20%;">
                <ui:VisualElement name="StatusPanel" class="status-panel-container" style="height: 30%;">
                    <ui:Label name="EmergencyStopLabel" text="Emergency stop: Off" class="status-emergency" />
                    <ui:Label name="SafeguardLabel" text="Safeguard: Off" class="status-safeguard" />
                    <ui:Label name="MotorsLabel" text="Motors: Off" class="status-motors" />
                    <ui:Label name="PowerLabel" text="Power: Low" class="status-power" />
                </ui:VisualElement>
                <ui:VisualElement name="EmptyMiddle" class="empty-section-20" style="height: 20%;" />
                <ui:VisualElement name="JointControlsPanel" class="joint-controls-container" style="height: 50%; width: 100%; justify-content: space-evenly;">
                    <ui:Button name="J1EnableDisable" text="Enable (J1)" class="footer-reset-button" style="height: 20%; width: 80%;" />
                    <ui:Button name="J2EnableDisable" text="Enable (J2)" class="footer-reset-button" style="height: 20%; width: 80%;" />
                    <ui:Button name="J3EnableDisable" text="Enable (J3)" class="footer-reset-button" style="height: 20%; width: 80%;" />
                    <ui:Button name="J4EnableDisable" text="Enable (J4)" class="footer-reset-button" style="height: 20%; width: 80%;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Footer" class="footer" style="flex-direction: row; height: 10%; width: 100%;">
            <ui:VisualElement name="FooterLeftSection" class="footer-left-section" style="width: 33%;">
                <ui:Button name="HomeButton" text="Home" class="footer-home-button" />
            </ui:VisualElement>
            <ui:VisualElement name="FooterCenterSection" class="footer-center-section" style="width: 33%; align-items: center; justify-content: center;">
                <ui:DropdownField choices="Select view,Default,Top,Front,Back,Left,Right" name="Views" class="views-dropdown" style="width: 50%;" />
            </ui:VisualElement>
            <ui:VisualElement name="FooterRightSection" class="footer-right-section" style="flex-direction: row; width: 33%; justify-content: flex-end; align-items: center;">
                <ui:Button name="FreeAllButton" text="Free all" class="footer-free-button" style="width: 40%;" />
                <ui:Button name="LockAllButton" text="Lock all" class="footer-lock-button" style="width: 40%;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SubpanelsAndSmokeMaskContainer" class="overlay-container">
            <ui:VisualElement name="CodeRain" class="code-rain" />
            <ui:VisualElement name="Scrim" class="ScrimTransparent" />
            <ui:VisualElement name="NavigationMenuPanel" class="NavigationMenuPanelOutMainScreen">
                <ui:VisualElement name="NavigationMenu" class="navigation-menu">
                    <ui:VisualElement name="NavHeader" class="nav-menu-header">
                        <ui:VisualElement name="NavUsernameContainer" class="nav-username-container">
                            <ui:Label name="NavUsernameLabel" text="Main Menu" class="nav-username" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="NavContent" class="nav-menu-content">
                        <ui:VisualElement name="NavRow1" class="nav-menu-row">
                            <ui:VisualElement name="DashboardContainer" class="nav-button-container">
                                <ui:Button name="DashboardButton" text="Dashboard" class="nav-button nav-button-active" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="NavRow2" class="nav-menu-row">
                            <ui:VisualElement name="TrainingContainer" class="nav-button-container">
                                <ui:Button name="TrainingButton" text="Training" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="NavRow3" class="nav-menu-row">
                            <ui:VisualElement name="OperationsContainer" class="nav-button-container">
                                <ui:Button name="OperationsButton" text="Operations" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="NavRow4" class="nav-menu-row">
                            <ui:VisualElement name="ReportsContainer" class="nav-button-container">
                                <ui:Button name="ReportsButton" text="Reports" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="NavRow5" class="nav-menu-row">
                            <ui:VisualElement name="SupportContainer" class="nav-button-container">
                                <ui:Button name="SupportButton" text="Support" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="NavRow6" class="nav-menu-row">
                            <ui:VisualElement name="SettingsContainer" class="nav-button-container">
                                <ui:Button name="SettingsButton" text="Settings" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="NavRow7" class="nav-menu-row">
                            <ui:VisualElement name="LogoutContainer" class="nav-button-container">
                                <ui:Button name="LogoutButton" text="Logout" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="NavRow8" class="nav-menu-row">
                            <ui:VisualElement name="SpacerLeft" class="nav-spacer-left" />
                            <ui:VisualElement name="SpacerRight" class="nav-spacer-right">
                                <ui:Label name="SpacerLabel" class="nav-spacer-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="HideMenuButton" class="hide-menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
