/* Estilos base existentes */
.ScrimTransparent {
    flex-grow: 1;
    position: relative;
    display: flex;
    background-color: rgba(0, 0, 0, 0.78);
    transition-duration: 1s;
    opacity: 0;
}

.ScrimOpaque {
    background-color: rgba(0, 0, 0, 0.78);
    opacity: 1;
}

.NavigationMenuPanelOutMainScreen {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: row;
    translate: -100% 0;
    transition-duration: 1s;
    transition-timing-function: ease-in-cubic;
}

.NavigationMenuPanelInMainScreen {
    translate: 0% 0;
}

.code-rain {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/_Images/Backgrounds/ekaterina-novitskaya-gLroHoWh_as-unsplash.jpg");
    background-size: 100% 100%;
    background-repeat: repeat;
    opacity: 0.15;
    z-index: -1;
}

/* Body principal */
.body {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    align-self: stretch;
    align-content: stretch;
    background-color: rgb(0, 0, 0);
    background-image: url("project://database/Assets/_Images/Backgrounds/scanlines2.jpg?fileID=2800000&guid=db31ce936e2104caba450d7ddc5ce66f&type=3#scanlines2");
    background-size: 100% 4px;
    background-repeat: repeat-y;
}

/* Header */
.header {
    flex-grow: 1;
    width: 100%;
    height: 10%;
    flex-direction: row;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 255, 0, 0.3);
}

.header-menu-panel {
    flex-grow: 1;
    width: 20%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.header-title-panel {
    flex-grow: 1;
    width: 20%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.header-dropdown-panel {
    flex-grow: 1;
    width: 30%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.menu-button {
    height: 80%;
    width: 60%;
    background-color: rgba(0, 0, 0, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(3, 255, 0);
    border-right-color: rgb(3, 255, 0);
    border-top-color: rgb(3, 255, 0);
    border-bottom-color: rgb(3, 255, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    color: rgb(0, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 28px;
    -unity-font-style: bold;
    transition-duration: 0.3s;
    transition-property: background-color, border-color, scale;
}

.menu-button:hover {
    background-color: rgba(0, 255, 0, 0.1);
    border-left-color: rgb(0, 255, 150);
    border-right-color: rgb(0, 255, 150);
    border-top-color: rgb(0, 255, 150);
    border-bottom-color: rgb(0, 255, 150);
    scale: 1.05;
}

.menu-button:active {
    scale: 0.95;
    background-color: rgba(0, 255, 0, 0.2);
}

.spare-header-label {
    color: rgb(255, 255, 255);
    font-size: 50px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    -unity-font-style: bold;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
}

.environment-dropdown, .arscara-dropdown, .views-dropdown {
    width: 80%;
    height: 50%;
    background-color: rgba(0, 0, 0, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    color: rgb(12, 53, 17);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 30px;
    transition-duration: 0.3s;
    transition-property: border-color, background-color;
}

.environment-dropdown:hover, .arscara-dropdown:hover, .views-dropdown:hover {
    border-left-color: rgb(0, 255, 150);
    border-right-color: rgb(0, 255, 150);
    border-top-color: rgb(0, 255, 150);
    border-bottom-color: rgb(0, 255, 150);
    background-color: rgba(0, 255, 0, 0.05);
}

/* Main Content */
.main {
    flex-grow: 1;
    width: 100%;
    height: 80%;
    flex-direction: row;
    padding: 10px;
}

/* Left Panel */
.main-left-section {
    flex-grow: 1;
    width: 30%;
    height: 100%;
    margin-right: 10px;
}

.motor-controls-container {
    flex-grow: 1;
    width: 100%;
    height: 33%;
    margin-bottom: 10px;
}

.motor-controls-inner {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0.6);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    padding: 10px;
}

.motor-row-1, .motor-row-2 {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-evenly;
    align-items: center;
    margin-bottom: 5px;
}

.motor-button-off, .motor-button-on, .power-button-low, .power-button-high {
    width: 40%;
    height: 50%;
    background-color: rgba(12, 53, 17, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(3, 255, 0);
    border-right-color: rgb(3, 255, 0);
    border-top-color: rgb(3, 255, 0);
    border-bottom-color: rgb(3, 255, 0);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    color: rgb(3, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 30px;
    -unity-font-style: bold;
    transition-duration: 0.3s;
    transition-property: background-color, border-color, scale;
}

.motor-button-off:hover, .motor-button-on:hover,
.power-button-low:hover, .power-button-high:hover {
    background-color: rgba(0, 255, 0, 0.1);
    border-left-color: rgb(0, 255, 150);
    border-right-color: rgb(0, 255, 150);
    border-top-color: rgb(0, 255, 150);
    border-bottom-color: rgb(0, 255, 150);
    scale: 1.03;
}

.motor-button-off:active, .motor-button-on:active,
.power-button-low:active, .power-button-high:active {
    scale: 0.97;
    background-color: rgba(0, 255, 0, 0.2);
}

/* Right Panel */
.main-right-section {
    flex-grow: 1;
    width: 20%;
    height: 100%;
    margin-left: 10px;
}

.status-panel-container {
    flex-grow: 1;
    width: 100%;
    height: 30%;
    background-color: rgba(0, 0, 0, 0.6);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    padding: 15px;
    justify-content: center;
    align-items: center;
    margin-bottom: 10px;
}

.status-emergency, .status-safeguard, .status-motors, .status-power {
    color: rgb(3, 255, 0);
    font-size: 30px;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-bottom: 5px;
    text-shadow: 0 0 8px rgba(3, 255, 0, 0.5);
}

.joint-controls-container {
    flex-grow: 1;
    width: 100%;
    height: 50%;
    background-color: rgba(0, 0, 0, 0.6);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    padding: 15px;
    justify-content: center;
    align-items: center;
}

.footer-reset-button {
    height: 80%;
    padding-left: 15px;
    padding-right: 15px;
    background-color: rgba(12, 53, 17, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(3, 255, 0);
    border-right-color: rgb(3, 255, 0);
    border-top-color: rgb(3, 255, 0);
    border-bottom-color: rgb(3, 255, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    color: rgb(3, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 30px;
    -unity-font-style: bold;
    transition-duration: 0.3s;
    transition-property: background-color, border-color, scale;
}

.footer-reset-button:hover {
    background-color: rgba(0, 255, 0, 0.1);
    border-left-color: rgb(0, 255, 150);
    border-right-color: rgb(0, 255, 150);
    border-top-color: rgb(0, 255, 150);
    border-bottom-color: rgb(0, 255, 150);
    scale: 1.02;
}

.footer-reset-button:active {
    scale: 0.98;
    background-color: rgba(0, 255, 0, 0.2);
}

.footer-lock-button {
    height: 80%;
    padding-left: 15px;
    padding-right: 15px;
    background-color: rgba(50, 30, 0, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(255, 140, 0);
    border-right-color: rgb(255, 140, 0);
    border-top-color: rgb(255, 140, 0);
    border-bottom-color: rgb(255, 140, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    color: rgb(255, 140, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 30px;
    -unity-font-style: bold;
    transition-duration: 0.3s;
    transition-property: background-color, border-color, scale;
}

.footer-lock-button:hover {
    background-color: rgba(80, 50, 0, 0.8);
    border-left-color: rgb(255, 165, 0);
    border-right-color: rgb(255, 165, 0);
    border-top-color: rgb(255, 165, 0);
    border-bottom-color: rgb(255, 165, 0);
    scale: 1.02;
}

.footer-lock-button:active {
    scale: 0.98;
    background-color: rgba(100, 60, 0, 0.8);
}

.footer-home-button, .footer-free-button, .footer-lock-button {
    height: 80%;
    padding-left: 15px;
    padding-right: 15px;
    background-color: rgba(12, 53, 17, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(3, 255, 0);
    border-right-color: rgb(3, 255, 0);
    border-top-color: rgb(3, 255, 0);
    border-bottom-color: rgb(3, 255, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    color: rgb(3, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 30px;
    -unity-font-style: bold;
    transition-duration: 0.3s;
    transition-property: background-color, border-color, scale;
}

.footer-home-button:hover, .footer-free-button:hover, .footer-lock-button:hover {
    background-color: rgba(0, 255, 0, 0.1);
    border-left-color: rgb(0, 255, 150);
    border-right-color: rgb(0, 255, 150);
    border-top-color: rgb(0, 255, 150);
    border-bottom-color: rgb(0, 255, 150);
    scale: 1.02;
}

.footer-home-button:active, .footer-free-button:active, .footer-lock-button:active {
    scale: 0.98;
    background-color: rgba(0, 255, 0, 0.2);
}

/* Contenedores vacíos */
.empty-section-33 {
    flex-grow: 1;
    width: 100%;
    height: 33%;
}

.empty-section-20 {
    flex-grow: 1;
    align-items: center;
}

/* Clases para modo transparente (Virtual Environment) */
.body-transparent {
    background-color: rgba(0, 0, 0, 0.3) !important;
    background-image: none !important;
}

.code-rain-transparent {
    opacity: 0 !important;
}

.motor-controls-inner-transparent {
    background-color: rgba(0, 0, 0, 0.4) !important;
}

.status-panel-container-transparent {
    background-color: rgba(0, 0, 0, 0.4) !important;
}

.joint-controls-container-transparent {
    background-color: rgba(0, 0, 0, 0.4) !important;
}

.navigation-menu-transparent {
    background-color: rgba(0, 0, 0, 0.8) !important;
}