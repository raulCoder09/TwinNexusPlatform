<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Scripts/Views/MenuSystem/SesSettings/SesSettings.uss?fileID=7433441132597879392&amp;guid=683459a95361345e2977a356ccdf52b8&amp;type=3#SesSettings" />
    <ui:VisualElement name="Body" class="body">
        <ui:VisualElement name="Header" class="header">
            <ui:VisualElement name="MenuPanel" class="menu-panel">
                <ui:Button name="MenuButton" text="Menu" class="menu-button" />
            </ui:VisualElement>
            <ui:VisualElement name="TitlePanel" class="spare-header-panel" style="width: 75%; align-items: center; align-self: center; align-content: center;">
                <ui:Label name="TitleLabel" text="SES Settings" class="spare-header-label" style="-unity-font-definition: url('project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&amp;guid=289b75764e32a4b85b2ee0c973db7173&amp;type=3#VT323-Regular'); font-size: 50px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Main" class="main">
            <ui:VisualElement name="MainLeft" class="main-left">
                <ui:VisualElement name="MainTopRow" class="main-top-row">
                    <ui:VisualElement name="SenderConfigPanel" class="widget-panel">
                        <ui:VisualElement name="SenderConfigHeader" class="widget-header">
                            <ui:Label name="SenderConfigTitle" text="Sender Configuration" class="widget-title" />
                        </ui:VisualElement>
                        <ui:VisualElement name="SenderConfigContent" class="widget-content">
                            <ui:Label name="SenderEmailLabel" text="Sender Email:" class="recent-activity-item" />
                            <ui:TextField name="SenderEmailField" class="device-mode-label" value="mechar09@gmail.com" disabled="true" />
                            <ui:Label name="SenderNameLabel" text="Sender Name:" class="recent-activity-item" />
                            <ui:TextField name="SenderNameField" class="device-mode-label" value="Twin Nexus Platform" />
                            <ui:Button name="SaveSenderConfigButton" text="Save" class="device-nav-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="TemplateManagementPanel" class="widget-panel">
                        <ui:VisualElement name="TemplateManagementHeader" class="widget-header">
                            <ui:Label name="TemplateManagementTitle" text="Email Templates" class="widget-title" />
                        </ui:VisualElement>
                        <ui:VisualElement name="TemplateManagementContent" class="widget-content">
                            <ui:VisualElement name="TemplateList" class="recent-activity-content">
                                <ui:Label name="Template1" text="welcome-template" class="recent-activity-item" />
                                <ui:Label name="Template2" text="system-alert-template" class="recent-activity-item" />
                                <ui:Label name="Template3" text="password-reset-template" class="recent-activity-item" />
                            </ui:VisualElement>
                            <ui:Button name="CreateTemplateButton" text="Create New Template" class="device-nav-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="MainBottomRow" class="main-bottom-row">
                    <ui:VisualElement name="EmailVerificationPanel" class="widget-panel system-status-panel">
                        <ui:VisualElement name="EmailVerificationHeader" class="widget-header">
                            <ui:Label name="EmailVerificationTitle" text="Email Verification" class="widget-title" />
                        </ui:VisualElement>
                        <ui:VisualElement name="EmailVerificationContent" class="widget-content">
                            <ui:TextField name="EmailToVerifyField" class="device-mode-label" value="Enter email to verify" />
                            <ui:Button name="VerifyEmailButton" text="Request Verification" class="device-nav-button" />
                            <ui:VisualElement name="VerifiedEmailsList" class="recent-activity-content">
                                <ui:Label name="VerifiedEmail1" text="mechar09@gmail.com (Verified)" class="recent-activity-item" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="MainRight" class="device-control-panel">
                <ui:VisualElement name="QuotaPanel" class="widget-panel">
                    <ui:VisualElement name="QuotaHeader" class="widget-header">
                        <ui:Label name="QuotaTitle" text="SES Quota Status" class="widget-title" />
                    </ui:VisualElement>
                    <ui:VisualElement name="QuotaContent" class="widget-content">
                        <ui:Label name="QuotaMax24Hour" text="Max 24h Send: Unknown" class="recent-activity-item" />
                        <ui:Label name="QuotaSent24Hour" text="Sent Last 24h: Unknown" class="recent-activity-item" />
                        <ui:Label name="QuotaRate" text="Max Send Rate: Unknown" class="recent-activity-item" />
                        <ui:Label name="QuotaUsage" text="Usage: Unknown%" class="recent-activity-item" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="TestConnectionPanel" class="widget-panel">
                    <ui:VisualElement name="TestConnectionHeader" class="widget-header">
                        <ui:Label name="TestConnectionTitle" text="Test SES Connection" class="widget-title" />
                    </ui:VisualElement>
                    <ui:VisualElement name="TestConnectionContent" class="widget-content">
                        <ui:Button name="TestConnectionButton" text="Send Test Email" class="device-nav-button" />
                        <ui:Label name="TestResult" text="Result: Not tested" class="recent-activity-item" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Footer" class="footer">
            <ui:VisualElement name="SparePanel0" class="footer-panel">
                <ui:Label name="SpareLabel0" class="footer-label" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel1" class="footer-panel">
                <ui:Label name="SpareLabel1" class="footer-label" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel2" class="footer-panel">
                <ui:Label name="SpareLabel2" class="footer-label" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel3" class="footer-panel">
                <ui:Label name="SpareLabel3" class="footer-label" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SubpanelsAndSmokeMaskContainer" class="overlay-container">
            <ui:VisualElement name="CodeRain" class="code-rain" />
            <ui:VisualElement name="Scrim" class="ScrimTransparent" />
            <ui:VisualElement name="NavigationMenuPanel" class="NavigationMenuPanelOutMainScreen">
                <ui:VisualElement name="NavigationMenu" class="navigation-menu">
                    <ui:VisualElement class="nav-menu-header">
                        <ui:VisualElement class="nav-username-container">
                            <ui:Label text="Main Menu" class="nav-username" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="nav-menu-content">
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Dashboard" class="nav-button nav-button-active" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement name="TrainingButton" class="nav-button-container">
                                <ui:Button name="TrainingButton" text="Training" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Operations" name="OperationsButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Reports" name="ReportsButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Support" name="SupportButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Settings" name="SettingsButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Logout" name="LogoutButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-spacer-left" />
                            <ui:VisualElement class="nav-spacer-right">
                                <ui:Label name="Label" class="nav-spacer-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="HideMenuButton" class="hide-menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>