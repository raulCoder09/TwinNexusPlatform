<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Scripts/Views/MenuSystem/Settings/Settings.uss?fileID=7433441132597879392&amp;guid=dc7f6e881b7bc4eb4b8eed75d408d0db&amp;type=3#Settings" />
    <ui:VisualElement name="Body">
        <ui:VisualElement name="Header">
            <ui:VisualElement name="MenuPanel">
                <ui:Button name="MenuButton" text="Menu" />
            </ui:VisualElement>
            <ui:VisualElement name="PonerAlgo">
                <ui:Label name="SpareLabel0" text="Settings Configuration" class="selected-mode-ui-name" />
            </ui:VisualElement>
            <ui:VisualElement name="UsernamePanel">
                <ui:Label name="Username" />
            </ui:VisualElement>
            <ui:VisualElement name="LogoutPanel">
                <ui:Label name="Logout" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Main">
            <ui:VisualElement name="ConfigurationGrid" class="config-grid" style="width: 80%; height: 80%;">
                <ui:VisualElement class="config-row">
                    <ui:Button name="IoTButton" text="IoT Configuration" class="config-button config-primary">
                        <ui:VisualElement class="config-icon-container">
                            <ui:Label text="🔧" class="config-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="config-label-container">
                            <ui:Label text="IoT Settings" class="config-title" />
                            <ui:Label text="Devices &amp; Connections" class="config-description" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="UserConfigButton" text="User Configuration" class="config-button config-primary">
                        <ui:VisualElement class="config-icon-container">
                            <ui:Label text="👤" class="config-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="config-label-container">
                            <ui:Label text="User Profile" class="config-title" />
                            <ui:Label text="Profile &amp; Preferences" class="config-description" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="CognitoConfigButton" text="Cognito Configuration" class="config-button config-admin">
                        <ui:VisualElement class="config-icon-container">
                            <ui:Label text="🔐" class="config-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="config-label-container">
                            <ui:Label text="Authentication" class="config-title" />
                            <ui:Label text="AWS Cognito Settings" class="config-description" />
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="config-row">
                    <ui:Button name="SystemConfigButton" text="System Configuration" class="config-button config-admin">
                        <ui:VisualElement class="config-icon-container">
                            <ui:Label text="⚙️" class="config-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="config-label-container">
                            <ui:Label text="System Settings" class="config-title" />
                            <ui:Label text="Global Configuration" class="config-description" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="NetworkConfigButton" text="Network Configuration" class="config-button config-admin">
                        <ui:VisualElement class="config-icon-container">
                            <ui:Label text="🌐" class="config-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="config-label-container">
                            <ui:Label text="Network Settings" class="config-title" />
                            <ui:Label text="Connectivity &amp; Protocols" class="config-description" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="DatabaseConfigButton" text="Database Configuration" class="config-button config-admin">
                        <ui:VisualElement class="config-icon-container">
                            <ui:Label text="🗄️" class="config-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="config-label-container">
                            <ui:Label text="Database Settings" class="config-title" />
                            <ui:Label text="DB Connections &amp; Schema" class="config-description" />
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="config-row">
                    <ui:Button name="SecurityConfigButton" text="Security Configuration" class="config-button config-admin">
                        <ui:VisualElement class="config-icon-container">
                            <ui:Label text="🛡️" class="config-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="config-label-container">
                            <ui:Label text="Security Settings" class="config-title" />
                            <ui:Label text="Access Control &amp; Certs" class="config-description" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="BackupConfigButton" text="Backup Configuration" class="config-button config-admin">
                        <ui:VisualElement class="config-icon-container">
                            <ui:Label text="💾" class="config-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="config-label-container">
                            <ui:Label text="Backup Settings" class="config-title" />
                            <ui:Label text="Auto-backup &amp; Recovery" class="config-description" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="AwsServicesConfigButton" class="config-button config-admin" style="border-left-color: rgb(0, 152, 255); border-right-color: rgb(0, 152, 255); border-top-color: rgb(0, 152, 255); border-bottom-color: rgb(0, 152, 255);">
                        <ui:VisualElement class="config-icon-container">
                            <ui:Label text="☁️" class="config-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="config-label-container">
                            <ui:Label text="AWS services" class="config-title" style="color: rgb(0, 151, 255);" />
                            <ui:Label text="AWS service configuration" class="config-description" />
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Footer">
            <ui:VisualElement name="SparePanel0">
                <ui:Label name="SpareLabel0" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel1">
                <ui:Label name="SpareLabel1" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel2">
                <ui:Label name="SpareLabel2" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel3">
                <ui:Label name="SpareLabel3" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SubpanelsAndSmokeMaskContainer">
            <ui:VisualElement name="Scrim" class="ScrimTransparent" />
            <ui:VisualElement name="NavigationMenuPanel" class="NavigationMenuPanelOutMainScreen">
                <ui:VisualElement name="NavigationMenu">
                    <ui:VisualElement class="nav-header">
                        <ui:VisualElement class="nav-username-container">
                            <ui:Label text="Main Menu" class="nav-username-label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="nav-body">
                        <ui:VisualElement class="nav-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Dashboard" name="DashboardButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-row">
                            <ui:VisualElement name="TrainingButton" class="nav-button-container">
                                <ui:Button name="TrainingButton" text="Training" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Operations" name="OperationsButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Reports" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Support" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Settings" name="SettingsButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Logout" name="LogoutButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-row">
                            <ui:VisualElement class="nav-spacer-container">
                                <ui:VisualElement class="nav-spacer" />
                            </ui:VisualElement>
                            <ui:VisualElement class="nav-label-container">
                                <ui:Label name="Label" class="nav-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="HideMenuButton" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
