<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Scripts/Views/MenuSystem/Dashboard/Dashboard.uss?fileID=7433441132597879392&amp;guid=c4e63ad4f89db4dd4a250e0ca80b68b9&amp;type=3#Dashboard" />
    <ui:VisualElement name="Body" class="body">
        <ui:VisualElement name="Header" class="header">
            <ui:VisualElement name="MenuPanel" class="menu-panel">
                <ui:Button name="MenuButton" text="Menu" class="menu-button" />
            </ui:VisualElement>
            <ui:VisualElement name="PonerAlgo" class="spare-header-panel">
                <ui:Label name="SpareLabel0" class="spare-header-label" />
            </ui:VisualElement>
            <ui:VisualElement name="UsernamePanel" class="username-panel">
                <ui:Label name="Username" class="username-label" />
            </ui:VisualElement>
            <ui:VisualElement name="LogoutPanel" class="logout-panel">
                <ui:Label name="Logout" class="logout-label" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Main" class="main">
            <ui:VisualElement name="VisualElement" class="main-left">
                <ui:VisualElement name="VisualElement" class="main-top-row">
                    <ui:VisualElement name="WidgetPanel0" class="widget-panel welcome-panel">
                        <ui:VisualElement class="widget-header">
                            <ui:Label text="Welcome back, Username" class="welcome-title" />
                        </ui:VisualElement>
                        <ui:VisualElement class="widget-content">
                            <ui:Label text="Here you can access the platform&apos;s main features, such as simulation, monitoring and reporting" class="welcome-description" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="WidgetPanel1" class="widget-panel iot-status-panel">
                        <ui:VisualElement class="widget-header">
                            <ui:Label text="IoT infrastructure status" class="widget-title" />
                        </ui:VisualElement>
                        <ui:VisualElement class="iot-status-header">
                            <ui:Label text="IoT infrastructure" class="iot-status-column-header" />
                            <ui:Label text="Connection status" class="iot-status-column-header" />
                            <ui:Label text="Connection mode" class="iot-status-column-header" />
                        </ui:VisualElement>
                        <ui:VisualElement class="iot-status-row">
                            <ui:Label text="Local IoT" class="iot-status-column" />
                            <ui:Label text="Offline" name="LocalIoTStatusLabel" class="iot-status-column" />
                            <ui:Label text="Manual" name="LocalIoTModeLabel" class="iot-status-column" />
                        </ui:VisualElement>
                        <ui:VisualElement class="iot-status-row">
                            <ui:Label text="VM IoT" class="iot-status-column" />
                            <ui:Label text="Offline" name="VMIoTStatusLabel" class="iot-status-column" />
                            <ui:Label text="Manual" name="VMIoTModeLabel" class="iot-status-column" />
                        </ui:VisualElement>
                        <ui:VisualElement class="iot-status-row">
                            <ui:Label text="AWS IoT core" class="iot-status-column" />
                            <ui:Label text="Offline" name="CloudIoTStatusLabel" class="iot-status-column" />
                            <ui:Label text="Manual" name="CloudlIoTModeLabel" class="iot-status-column" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="main-bottom-row">
                    <ui:VisualElement name="WidgetPanel2" class="widget-panel system-status-panel">
                        <ui:VisualElement class="widget-header">
                            <ui:Label text="System status" class="widget-title" />
                        </ui:VisualElement>
                        <ui:VisualElement class="system-status-content">
                            <ui:VisualElement class="system-status-devices">
                                <ui:Label text="ARSCARA" class="system-device-name" />
                                <ui:Label text="Robotics kit 1" class="system-device-name" />
                                <ui:Label text="Robotics kit 2" class="system-device-name" />
                                <ui:Label text="Device 3" class="system-device-name" />
                            </ui:VisualElement>
                            <ui:VisualElement class="system-status-states">
                                <ui:Label text="Online" class="system-status-online" />
                                <ui:Label text="Online" class="system-status-online" />
                                <ui:Label text="Offline" class="system-status-offline" />
                                <ui:Label text="Offline" class="system-status-offline-red" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="WidgetPanel3" class="widget-panel recent-activity-panel">
                        <ui:VisualElement class="widget-header">
                            <ui:Label text="Recent activity" class="recent-activity-title" />
                        </ui:VisualElement>
                        <ui:VisualElement class="recent-activity-content">
                            <ui:Label text="ARSCARA simulation started ar 10:05 am" class="recent-activity-item" />
                            <ui:Label text="ARSCARA monitoring stopped ar 9:45 am" class="recent-activity-item" />
                            <ui:Label text="ARSCARA report generated ar 9:30 am" class="recent-activity-item" />
                            <ui:Label text="[View full history]" class="recent-activity-link" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="VisualElement" class="main-right device-control-panel">
                <ui:VisualElement class="device-control-header">
                    <ui:VisualElement class="device-nav-left">
                        <ui:Button text="&lt;" class="device-nav-button" />
                    </ui:VisualElement>
                    <ui:VisualElement class="device-title-container">
                        <ui:Label text="ARSCARA" class="device-title" />
                    </ui:VisualElement>
                    <ui:VisualElement class="device-nav-right">
                        <ui:Button text="&gt;" class="device-nav-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="device-status-row">
                    <ui:VisualElement class="device-status-container">
                        <ui:Label text="Online" class="device-status-online" />
                    </ui:VisualElement>
                    <ui:VisualElement class="device-status-container">
                        <ui:Label text="Busy" class="device-status-busy" />
                    </ui:VisualElement>
                    <ui:VisualElement class="device-status-container">
                        <ui:Label text="Alarmed" class="device-status-alarmed" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="device-visualization-container">
                    <ui:VisualElement class="device-visualization-box" />
                </ui:VisualElement>
                <ui:VisualElement class="device-controls-bottom">
                    <ui:VisualElement class="device-mode-container">
                        <ui:Label text="Automatic mode" class="device-mode-label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="device-coordinates-container">
                        <ui:VisualElement class="coordinate-container">
                            <ui:Label text="X:000.000 mm" class="coordinate-label" />
                        </ui:VisualElement>
                        <ui:VisualElement class="coordinate-container">
                            <ui:Label text="Y:000.000 mm" class="coordinate-label" />
                        </ui:VisualElement>
                        <ui:VisualElement class="coordinate-container">
                            <ui:Label text="Z:000.000 mm" class="coordinate-label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Footer" class="footer">
            <ui:VisualElement name="SparePanel0" class="footer-panel">
                <ui:Label name="SpareLabel0" class="footer-label" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel1" class="footer-panel">
                <ui:Label name="SpareLabel1" class="footer-label" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel2" class="footer-panel">
                <ui:Label name="SpareLabel2" class="footer-label" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel3" class="footer-panel">
                <ui:Label name="SpareLabel3" class="footer-label" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SubpanelsAndSmokeMaskContainer" class="overlay-container">
            <ui:VisualElement name="CodeRain" class="code-rain" />
            <ui:VisualElement name="Scrim" class="ScrimTransparent" />
            <ui:VisualElement name="NavigationMenuPanel" class="NavigationMenuPanelOutMainScreen">
                <ui:VisualElement name="NavigationMenu" class="navigation-menu">
                    <ui:VisualElement class="nav-menu-header">
                        <ui:VisualElement class="nav-username-container">
                            <ui:Label text="Main Menu" class="nav-username" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="nav-menu-content">
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Dashboard" class="nav-button nav-button-active" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement name="TrainingButton" class="nav-button-container">
                                <ui:Button name="TrainingButton" text="Training" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Operations" name="OperationsButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Reports" name="ReportsButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Support" name="SupportButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Settings" name="SettingsButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Logout" name="LogoutButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-spacer-left" />
                            <ui:VisualElement class="nav-spacer-right">
                                <ui:Label name="Label" class="nav-spacer-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="HideMenuButton" class="hide-menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
