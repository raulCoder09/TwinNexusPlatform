/* General Styles */
#Body {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    align-self: stretch;
    align-content: stretch;
    background-color: rgb(0, 0, 0);
    background-image: url("project://database/Assets/_Images/Backgrounds/scanlines2.jpg");
    background-size: 100% 4px;
    background-repeat: repeat-y;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

/* Header Styles */
#Header {
    flex-grow: 1;
    width: 100%;
    height: 10%;
    flex-direction: row;
}

#InstitutionNamePanel {
    flex-grow: 1;
    height: auto;
    justify-content: center;
    width: 100%;
}

#UniversityName {
    color: rgb(0, 255, 0);
    font-size: 30px;
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    text-shadow: 0 0 5px rgba(0, 255, 0, 0.5);
}

/* Main Styles */
#Main {
    flex-grow: 1;
    width: 100%;
    height: 80%;
    justify-content: space-between;
    align-self: stretch;
    align-content: stretch;
}

#TitlePanel {
    flex-grow: 1;
    width: 100%;
    height: 27%;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
}

#Title {
    color: rgb(0, 255, 0);
    font-size: 120px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    -unity-font-style: normal;
    text-shadow: 0 0 10px rgba(0, 255, 0, 0.8);
    transition-property: opacity, translate, text-shadow; /* NEW: Transitions for glitch */
    transition-duration: 0.2s;
    transition-timing-function: linear;
}

#Title.glitch {
    opacity: 0.8;
    translate: 2px 0;
    text-shadow: 0 0 10px rgba(0, 200, 0, 0.5); /* NEW: Lower opacity for subtlety */
}

#SubtitlePanel {
    flex-grow: 1;
    width: 100%;
    height: 26%;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
}

#Subtitle {
    color: rgb(0, 255, 0);
    font-size: 60px;
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    text-shadow: 0 0 5px rgba(0, 255, 0, 0.5);
}

#ButtonsPanel {
    flex-grow: 1;
    flex-direction: row;
    width: 100%;
    height: 27%;
    justify-content: space-around;
    align-self: stretch;
    align-content: stretch;
    align-items: stretch;
}

#ExitButtonPanel, #LaunchButtonPanel {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    align-self: center;
    align-content: center;
}

/* Footer Styles */
#Footer {
    flex-grow: 1;
    width: 100%;
    height: 10%;
    justify-content: center;
    align-self: center;
    align-items: center;
    align-content: stretch;
}

#AdditionalInformation {
    color: rgb(0, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 24px;
    text-shadow: 0 0 5px rgba(0, 255, 0, 0.5);
}

#MessageLabel {
    color: rgb(0, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 24px;
    -unity-text-align: middle-center;
    margin-top: 10px;
    display: none;
    text-shadow: 0 0 5px rgba(0, 255, 0, 0.5);
}



/* Panel Container */
#SubpanelsAndSmokeMaskContainer {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: absolute;
    top: auto;
    opacity: 1;
    visibility: visible;
}

.Scrim {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    opacity: 0;
    transition-duration: 0.5s;
}

.ScrimFadein {
    opacity: 1;
    background-color: rgba(0, 0, 0, 0.8);
    box-shadow: inset 0 0 10px rgba(0, 255, 0, 0.3);
}

.LoginPanelMoveA {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 50%;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    translate: 0 100%;
    scale: 0.9; /* NEW: Reduced scale on exit */
    opacity: 0; /* NEW: Fade out */
    skew: 2deg; /* NEW: Slight skew on exit */
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out; /* NEW: Smoother transition */
    transition-property: translate, scale, opacity, skew; /* NEW: Transition all properties */
}


.LoginPanelMoveB {
    translate: 0 0%;
    scale: 1; /* NEW: Full scale on entry */
    opacity: 1; /* NEW: Fully visible */
    skew: 0deg; /* NEW: No skew on entry */
    box-shadow: 0 0 15px rgba(0, 255, 0, 0.7);
}

.RegisterPanelOutMainScreen {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 50%;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    translate: 100% 0;
    scale: 0.9; /* NEW: Reduced scale on exit */
    opacity: 0; /* NEW: Fade out */
    skew: -2deg; /* NEW: Slight skew on exit */
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out; /* NEW: Smoother transition */
    transition-property: translate, scale, opacity, skew; /* NEW: Transition all properties */
}

.RegisterPanelInMainScreen {
    translate: 0% 0;
    scale: 1; /* NEW: Full scale on entry */
    opacity: 1; /* NEW: Fully visible */
    skew: 0deg; /* NEW: No skew on entry */
    box-shadow: 0 0 15px rgba(0, 255, 0, 0.7);
}

.RecoverPasswordPanelOutMainScreen {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 50%;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    translate: -100% 0;
    scale: 0.9; /* NEW: Reduced scale on exit */
    opacity: 0; /* NEW: Fade out */
    skew: 2deg; /* NEW: Slight skew on exit */
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out; /* NEW: Smoother transition */
    transition-property: translate, scale, opacity, skew; /* NEW: Transition all properties */
}

.RecoverPasswordPanelInMainScreen {
    translate: 0% 0;
    scale: 1; /* NEW: Full scale on entry */
    opacity: 1; /* NEW: Fully visible */
    skew: 0deg; /* NEW: No skew on entry */
    box-shadow: 0 0 15px rgba(0, 255, 0, 0.7);
}

.EmailVerificationPanelOutMainScreen {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 50%;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    translate: 100% 0;
    scale: 0.9; /* NEW: Reduced scale on exit */
    opacity: 0; /* NEW: Fade out */
    skew: -2deg; /* NEW: Slight skew on exit */
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out; /* NEW: Smoother transition */
    transition-property: translate, scale, opacity, skew; /* NEW: Transition all properties */
}

.EmailVerificationPanelInMainScreen {
    translate: 0% 0;
    scale: 1; /* NEW: Full scale on entry */
    opacity: 1; /* NEW: Fully visible */
    skew: 0deg; /* NEW: No skew on entry */
    box-shadow: 0 0 15px rgba(0, 255, 0, 0.7);
}

/* Generic Cyberpunk Styles */
.button-cyberpunk {
    color: rgb(0, 255, 0);
    background-color: rgb(0, 0, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 50px;
    -unity-font-style: normal;
    transition-duration: 0.2s;
    transition-timing-function: linear;
    box-shadow: 0 0 10px rgba(0, 255, 0, 0.7), 0 0 20px rgba(0, 255, 0, 0.3);
}

.button-cyberpunk:hover {
    background-color: rgb(0, 255, 0);
    color: rgb(0, 0, 0);
    box-shadow: 0 0 15px rgba(0, 200, 0, 0.8), 0 0 25px rgba(0, 200, 0, 0.6);
}

.button-cyberpunk:active {
    background-color: rgb(0, 200, 0);
    color: rgb(0, 0, 0);
    box-shadow: 0 0 10px rgba(0, 200, 0, 0.8);
}

.small-button {
    width: 25%;
    height: 25%;
    font-size: 30px;
}

.close-button {
    color: rgb(0, 255, 0);
    background-color: rgba(188, 188, 188, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 60px;
    -unity-font-style: bold;
    right: 46px;
    top: 29px;
    text-shadow: 0 0 5px rgba(0, 255, 0, 0.5);
}

.textfield-cyberpunk {
    width: 50%;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 28px;
    color: rgb(0, 255, 0);
    background-color: rgb(0, 0, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    box-shadow: 0 0 8px rgba(0, 255, 0, 0.5);
}

.label-cyberpunk {
    color: rgb(0, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 32px;
    -unity-text-align: middle-center;
    white-space: normal;
    text-shadow: 0 0 5px rgba(0, 255, 0, 0.5);
}

/* Panel-Specific Styles */
#LoginPanel, #RegisterPanel, #RecoverPasswordPanel, #EmailVerificationPanel {
    background-color: rgb(0, 0, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

#HeaderLogin, #HeaderRecoverPassword {
    flex-grow: 1;
    flex-direction: row;
    width: 100%;
    height: 33%;
}

#HeaderRegister, #HeaderEmailVerification {
    flex-grow: 1;
    flex-direction: row;
    width: 100%;
    height: 25%;
}

#TitleLoginPanel, #TitleRecoverPasswordPanel {
    flex-grow: 1;
    width: 50%;
    height: 100%;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
}

#TitleRegisterPanel, #TitleEmailVerificationPanel {
    flex-grow: 1;
    width: 50%;
    height: 100%;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
}

#TitleLogin, #TitleRegister, #TitleRecoverPassword {
    color: rgb(0, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 100px;
    -unity-font-style: normal;
    text-shadow: 0 0 10px rgba(0, 255, 0, 0.8);
    transition-property: opacity, translate, text-shadow; /* NEW: Transitions for glitch */
    transition-duration: 0.2s;
    transition-timing-function: linear;
}

#TitleLogin.glitch, #TitleRegister.glitch, #TitleRecoverPassword.glitch {
    opacity: 0.8;
    translate: 2px 0;
    text-shadow: 0 0 10px rgba(0, 200, 0, 0.5); /* NEW: Lower opacity for subtlety */
}

#TitleEmailVerification {
    color: rgb(0, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 80px;
    -unity-font-style: normal;
    text-shadow: 0 0 10px rgba(0, 255, 0, 0.8);
    transition-property: opacity, translate, text-shadow; /* NEW: Transitions for glitch */
    transition-duration: 0.2s;
    transition-timing-function: linear;
}

#TitleEmailVerification.glitch {
    opacity: 0.8;
    translate: 2px 0;
    text-shadow: 0 0 10px rgba(0, 200, 0, 0.5); /* NEW: Lower opacity for subtlety */
}

#CloseLoginPanel, #CloseRegisterPanel, #CloseRecoverPasswordPanel, #CloseEmailVerificationPanel {
    flex-grow: 1;
    width: 50%;
    height: 100%;
    align-items: flex-end;
    align-self: flex-end;
    right: auto;
}

#InputLoginPanel, #InputRecoverPasswordPanel, #InputEmailVerificationPanel {
    flex-grow: 1;
    width: 100%;
    height: 33%;
    justify-content: space-evenly;
    align-items: center;
    align-self: stretch;
    align-content: center;
}

#InputRegisterPanel {
    flex-grow: 1;
    width: 100%;
    height: 50%;
    justify-content: space-evenly;
    align-items: center;
    align-self: stretch;
    align-content: center;
}

#ButtonLoginPanel, #ButtonRecoverPasswordPanel {
    flex-grow: 1;
    flex-direction: row;
    width: 100%;
    height: 33%;
    justify-content: space-evenly;
    align-self: center;
    align-items: center;
    align-content: stretch;
}

#ButtonRegisterPanel, #ButtonEmailVerificationPanel {
    flex-grow: 1;
    flex-direction: row;
    width: 100%;
    height: 25%;
    justify-content: space-evenly;
    align-self: center;
    align-items: center;
    align-content: stretch;
}

#InstructionsEmailVerificationPanel {
    flex-grow: 1;
    width: 100%;
    height: 25%;
    justify-content: center;
    align-items: center;
    align-self: stretch;
    align-content: center;
}

#EmailVerificationInstructions {
    width: 80%;
}

#EmailVerificationEmail {
    font-size: 28px;
    -unity-font-style: bold;
    margin-top: 10px;
}

#VerificationCodeField {
    font-size: 32px;
    letter-spacing: 5px;
}

/* Code Rain Styles */
.code-rain {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/_Images/Backgrounds/code-rain1.jpg"); /* NEW: Code rain image */
    background-size: 100% 100%; /* NEW: Fill the container */
    background-repeat: repeat; /* NEW: Repeat horizontally and vertically */
    opacity: 0.15; /* NEW: Subtle opacity */
    z-index: -1; /* NEW: Behind other elements */
}