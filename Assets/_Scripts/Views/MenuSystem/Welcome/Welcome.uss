#Body {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    align-self: stretch;
    align-content: stretch;
    background-color: rgb(0, 0, 0);
}

#Header {
    flex-grow: 1;
    width: 100%;
    height: 10%;
    flex-direction: row;
}

#InstitutionNamePanel {
    flex-grow: 1;
    height: auto;
    justify-content: center;
    width: 50%;
}

#UniversityName {
    color: rgb(0, 255, 0);
    font-size: 30px;
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}

#LogoPanel {
    flex-grow: 1;
    justify-content: center;
    align-self: stretch;
    align-content: center;
    align-items: center;
    width: 50%;
}

#Logo {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    width: 70px;
    height: auto;
    background-image: url("project://database/Assets/_Images/Logos/UdeGLogo.png?fileID=2800000&guid=35cb058d0f87c40588a599803f141ec5&type=3#UdeGLogo");
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
    margin-top: 3px;
}

#Main {
    flex-grow: 1;
    width: 100%;
    height: 80%;
    justify-content: space-between;
    align-self: stretch;
    align-content: stretch;
}

#TitlePanel {
    flex-grow: 1;
    width: 100%;
    height: 27%;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
}

#Title {
    color: rgb(0, 255, 0);
    font-size: 120px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}

#SubtitlePanel {
    flex-grow: 1;
    width: 100%;
    height: 26%;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
}

#Subtitle {
    color: rgb(0, 255, 0);
    font-size: 60px;
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}

#ButtonsPanel {
    flex-grow: 1;
    flex-direction: row;
    width: 100%;
    height: 27%;
    justify-content: space-around;
    align-self: stretch;
    align-content: stretch;
    align-items: stretch;
}

#ExitButtonPanel {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    align-self: center;
    align-content: center;
}

#LaunchButtonPanel {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    align-self: center;
    align-content: center;
}

#ExitButton {
    width: 25%;
    height: 25%;
    font-size: 50px;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    background-color: rgb(0, 0, 0);
    color: rgb(0, 255, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    transition-duration: 0.2s;
    transition-timing-function: linear;
}

#LaunchButton {
    width: 25%;
    height: 25%;
    font-size: 50px;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    background-color: rgb(0, 0, 0);
    color: rgb(0, 255, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    transition-duration: 0.2s;
    transition-timing-function: linear;
}

#ExitButton:hover {
    background-color: rgb(0, 255, 0);
    color: rgb(0, 0, 0);
}

#LaunchButton:hover {
    background-color: rgb(0, 255, 0);
    color: rgb(0, 0, 0);
}

#ExitButton:active {
    background-color: rgb(0, 200, 0);
    color: rgb(0, 0, 0);
}

#LaunchButton:active {
    background-color: rgb(0, 200, 0);
    color: rgb(0, 0, 0);
}

#Footer {
    flex-grow: 1;
    width: 100%;
    height: 10%;
    justify-content: center;
    align-self: center;
    align-items: center;
    align-content: stretch;
}

#AdditionalInformation {
    color: rgb(0, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 24px;
}

#MessageLabel {
    color: rgb(0, 255, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 24px;
    -unity-text-align: middle-center;
    margin-top: 10px;
}

.LoginPanelMoveA {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 50%;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    translate: 0 100%;
    transition-duration: 0.5s;
    transition-timing-function: linear;
}

.LoginPanelMoveB {
    translate: 0 0%;
}

.RegisterPanelOutMainScreen {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 50%;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    translate: 100% 0;
    transition-duration: 0.5s;
    transition-timing-function: linear;
}

.RegisterPanelInMainScreen {
    translate: 0% 0;
}

.RecoverPasswordPanelOutMainScreen {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 50%;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    translate: -100% 0;
    transition-duration: 0.5s;
    transition-timing-function: linear;
}

.RecoverPasswordPanelInMainScreen {
    translate: 0% 0;
}

.EmailVerificationPanelOutMainScreen {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 50%;
    bottom: 0;
    background-color: rgb(0, 0, 0);
