<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Scripts/Views/MenuSystem/Welcome/Welcome.uss?fileID=7433441132597879392&amp;guid=7390afbe6d35e43fcb718e105ce0a009&amp;type=3#Welcome" />
    <ui:VisualElement name="Body">
        <ui:VisualElement name="Header">
            <ui:VisualElement name="InstitutionNamePanel">
                <ui:Label name="UniversityName" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Main">
            <ui:VisualElement name="TitlePanel">
                <ui:Label text="Twin Nexus Platform" name="Title" />
            </ui:VisualElement>
            <ui:VisualElement name="SubtitlePanel">
                <ui:Label text="Auxiliary platform for the manipulation, monitoring, and simulation of industrial automation systems" name="Subtitle" />
            </ui:VisualElement>
            <ui:VisualElement name="ButtonsPanel">
                <ui:VisualElement name="ExitButtonPanel" style="width: 33%;">
                    <ui:Button text="Exit" name="ExitButton" class="button-cyberpunk" />
                </ui:VisualElement>
                <ui:VisualElement name="SettingsCognitoParametersButtonPanel" style="width: 33%; justify-content: center; align-items: center;">
                    <ui:Button text="Settings Cognito Parameters" name="SettingsCognitoParametersButtonButton" class="button-cyberpunk" />
                </ui:VisualElement>
                <ui:VisualElement name="LaunchButtonPanel" style="height: 100%; width: 33%;">
                    <ui:Button text="Launch" name="LaunchButton" class="button-cyberpunk" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Footer">
            <ui:Label name="AdditionalInformation" />
            <ui:Label name="MessageLabel" />
        </ui:VisualElement>
        <ui:VisualElement name="SubpanelsAndSmokeMaskContainer" style="display: flex;">
            <ui:VisualElement name="CodeRain" class="code-rain" />
            <ui:VisualElement name="Scrim" class="Scrim" />
            <ui:VisualElement name="LoginPanel" class="LoginPanelMoveA" style="height: 100%;">
                <ui:VisualElement name="HeaderLogin">
                    <ui:VisualElement name="TitleLoginPanel">
                        <ui:Label text="Login" name="TitleLogin" />
                    </ui:VisualElement>
                    <ui:VisualElement name="CloseLoginPanel">
                        <ui:Button text="X" name="CloseLoginButton" class="close-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="InputLoginPanel">
                    <ui:TextField name="UsernameLoginField" placeholder-text="Username or Email" class="textfield-cyberpunk" />
                    <ui:TextField name="PasswordLoginField" password="true" placeholder-text="Password" hide-placeholder-on-focus="false" class="textfield-cyberpunk" />
                </ui:VisualElement>
                <ui:VisualElement name="ButtonLoginPanel">
                    <ui:Button text="Register" name="RegisterLoginButton" class="button-cyberpunk small-button" />
                    <ui:Button text="Recover password" name="RecoverPasswordLoginButton" class="button-cyberpunk small-button" />
                    <ui:Button text="Login" name="LoginButton" class="button-cyberpunk small-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="RegisterPanel" class="RegisterPanelOutMainScreen" style="height: 100%;">
                <ui:VisualElement name="HeaderRegister">
                    <ui:VisualElement name="TitleRegisterPanel">
                        <ui:Label text="Register" name="TitleRegister" />
                    </ui:VisualElement>
                    <ui:VisualElement name="CloseRegisterPanel">
                        <ui:Button text="X" name="CloseRegisterPanelButton" class="close-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="InputRegisterPanel">
                    <ui:TextField name="UsernameRegisterField" placeholder-text="Username" class="textfield-cyberpunk" />
                    <ui:TextField name="EmailRegisterField" placeholder-text="Email" hide-placeholder-on-focus="false" class="textfield-cyberpunk" />
                    <ui:TextField name="PhoneRegisterField" placeholder-text="Phone Number (Optional)" hide-placeholder-on-focus="false" class="textfield-cyberpunk" />
                    <ui:TextField name="PasswordRegisterField" placeholder-text="Password" password="true" class="textfield-cyberpunk" />
                    <ui:TextField name="RepeatPasswordRegisterField" placeholder-text="Repeat password" password="true" class="textfield-cyberpunk" />
                </ui:VisualElement>
                <ui:VisualElement name="ButtonRegisterPanel">
                    <ui:Button text="Back" name="BackToLoginPanelFromRegisterButton" class="button-cyberpunk small-button" />
                    <ui:Button text="Register and Login" name="RegisterAndLoginButton" class="button-cyberpunk small-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="RecoverPasswordPanel" class="RecoverPasswordPanelOutMainScreen" style="height: 100%;">
                <ui:VisualElement name="HeaderRecoverPassword">
                    <ui:VisualElement name="TitleRecoverPasswordPanel">
                        <ui:Label text="Recover password" name="TitleRecoverPassword" />
                    </ui:VisualElement>
                    <ui:VisualElement name="CloseRecoverPasswordPanel">
                        <ui:Button text="X" name="CloseRecoverPasswordButton" class="close-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="InputRecoverPasswordPanel">
                    <ui:TextField name="EmailRecoverField" placeholder-text="Email to recover" class="textfield-cyberpunk" />
                </ui:VisualElement>
                <ui:VisualElement name="ButtonRecoverPasswordPanel">
                    <ui:Button text="Back" name="BackToLoginPanelFromRecoverPasswordButton" class="button-cyberpunk small-button" />
                    <ui:Button text="Recover" name="RecoverPasswordButton" class="button-cyberpunk small-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="EmailVerificationPanel" class="EmailVerificationPanelOutMainScreen" style="height: 100%;">
                <ui:VisualElement name="HeaderEmailVerification">
                    <ui:VisualElement name="TitleEmailVerificationPanel">
                        <ui:Label text="Email Verification" name="TitleEmailVerification" />
                    </ui:VisualElement>
                    <ui:VisualElement name="CloseEmailVerificationPanel">
                        <ui:Button text="X" name="CloseEmailVerificationButton" class="close-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="InstructionsEmailVerificationPanel">
                    <ui:Label name="EmailVerificationInstructions" text="Please check your email and enter the verification code below:" class="label-cyberpunk" />
                    <ui:Label name="EmailVerificationEmail" class="label-cyberpunk" />
                </ui:VisualElement>
                <ui:VisualElement name="InputEmailVerificationPanel">
                    <ui:TextField name="VerificationCodeField" placeholder-text="Enter 6-digit verification code" class="textfield-cyberpunk" />
                </ui:VisualElement>
                <ui:VisualElement name="ButtonEmailVerificationPanel">
                    <ui:Button text="Back to Login" name="BackToLoginFromVerificationButton" class="button-cyberpunk small-button" />
                    <ui:Button text="Resend Code" name="ResendVerificationCodeButton" class="button-cyberpunk small-button" />
                    <ui:Button text="Verify Email" name="VerifyEmailButton" class="button-cyberpunk small-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="SettingsCognitoParametersPanel" class="SettingsCognitoParametersPanelOutMainScreen" style="width: 100%;">
                <ui:VisualElement name="HeaderSettingsCognitoParameters" style="flex-direction: row; width: 100%; height: 10%;">
                    <ui:VisualElement name="TitleSettingsCognitoParametersPanel" style="align-items: flex-start; width: 90%;">
                        <ui:Label text="Settings Cognito Parameters" name="TitleEmailVerification" />
                    </ui:VisualElement>
                    <ui:VisualElement name="CloseSettingsCognitoParametersPanel" style="width: 10%; align-items: center; justify-content: center; align-self: center; align-content: center;">
                        <ui:Button text="X" name="CloseSettingsCognitoParametersButton" class="close-button" style="align-items: center; justify-content: center; align-self: center;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="InstructionsSettingsCognitoParametersPanel" style="width: 100%; height: 10%; justify-content: center;">
                    <ui:Label name="SettingsCognitoParametersInstructions" text="Please enter the data required by Cognito" class="label-cyberpunk" style="width: 100%;" />
                </ui:VisualElement>
                <ui:VisualElement name="InputSettingsCognitoParametersPanel" style="width: 100%; height: 70%; align-items: center; justify-content: space-evenly;">
                    <ui:TextField name="UserPoolIdField" placeholder-text="Enter User Pool Id" class="textfield-cyberpunk" style="height: 10%;" />
                    <ui:TextField name="ClientIdField" placeholder-text="Enter Client Id" class="textfield-cyberpunk" style="height: 10%;" />
                    <ui:TextField name="IdentityPoolIdField" placeholder-text="Enter Identity Pool Id" class="textfield-cyberpunk" style="height: 10%;" />
                    <ui:DropdownField name="AwsRegionDropdownField" choices="AWS Region" style="width: 50%; height: 10%;" />
                </ui:VisualElement>
                <ui:VisualElement name="ButtonSettingsCognitoParametersPanel" style="width: 100%; height: 10%; justify-content: center; align-items: center;">
                    <ui:Button text="Save" name="SaveButton" class="button-cyberpunk small-button" style="height: 50%;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
