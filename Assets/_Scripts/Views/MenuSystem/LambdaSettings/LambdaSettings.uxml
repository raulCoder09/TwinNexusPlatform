<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Scripts/Views/MenuSystem/LambdaSettings/LambdaSettings.uss?fileID=7433441132597879392&amp;guid=3e3bfbfee130b4680a12def52b1f8f46&amp;type=3#LambdaSettings" />
    <ui:VisualElement name="Body" class="body">
        <ui:VisualElement name="Header" class="header">
            <ui:VisualElement name="MenuPanel" class="menu-panel">
                <ui:Button name="MenuButton" text="Menu" class="menu-button" />
            </ui:VisualElement>
            <ui:VisualElement name="TitlePanel" class="spare-header-panel" style="width: 75%; align-items: center; align-self: center; align-content: center;">
                <ui:Label name="TitleLabel" text="Lambda Settings" class="spare-header-label" style="-unity-font-definition: url(&quot;project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&amp;guid=289b75764e32a4b85b2ee0c973db7173&amp;type=3#VT323-Regular&quot;); font-size: 50px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Main" class="main">
            <ui:VisualElement name="MainLeft" class="main-left">
                <ui:VisualElement name="MainTopRow" class="main-top-row">
                    <ui:VisualElement name="ExecuteFunctionPanel" class="widget-panel">
                        <ui:VisualElement name="ExecuteFunctionHeader" class="widget-header">
                            <ui:Label name="ExecuteFunctionTitle" text="Execute Function" class="widget-title" />
                        </ui:VisualElement>
                        <ui:VisualElement name="ExecuteFunctionContent" class="widget-content" style="align-items: center; justify-content: space-evenly;">
                            <ui:Label name="FunctionNameLabel" text="Function Name:" class="recent-activity-item" />
                            <ui:DropdownField name="FunctionNameField" value="test" choices="test,TwinNexus-UserManagement,TwinNexus-IoTMonitor,TwinNexus-StudentPortal" class="device-mode-label" style="width: 50%;" />
                            <ui:Label name="PayloadLabel" text="Payload (JSON):" class="recent-activity-item" />
                            <ui:TextField name="PayloadField" value="{}" multiline="true" class="device-mode-label" style="width: 50%;" />
                            <ui:Button name="ExecuteFunctionButton" text="Execute Function" class="device-nav-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="ExecuteWithContextPanel" class="widget-panel">
                        <ui:VisualElement name="ExecuteWithContextHeader" class="widget-header">
                            <ui:Label name="ExecuteWithContextTitle" text="Execute with Context" class="widget-title" />
                        </ui:VisualElement>
                        <ui:VisualElement name="ExecuteWithContextContent" class="widget-content" style="align-items: center; justify-content: space-evenly;">
                            <ui:Label name="FunctionNameContextLabel" text="Function Name:" class="recent-activity-item" />
                            <ui:DropdownField name="FunctionNameContextField" value="test" choices="test,TwinNexus-UserManagement,TwinNexus-IoTMonitor,TwinNexus-StudentPortal" class="device-mode-label" style="width: 50%;" />
                            <ui:Label name="AdditionalPayloadLabel" text="Additional Payload (JSON):" class="recent-activity-item" />
                            <ui:TextField name="AdditionalPayloadField" value="{}" multiline="true" class="device-mode-label" style="width: 50%;" />
                            <ui:Button name="ExecuteWithContextButton" text="Execute with Context" class="device-nav-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="FunctionStatusPanel" class="widget-panel">
                        <ui:VisualElement name="FunctionStatusHeader" class="widget-header">
                            <ui:Label name="FunctionStatusTitle" text="Available Functions" class="widget-title" />
                        </ui:VisualElement>
                        <ui:VisualElement name="FunctionStatusContent" class="widget-content" style="align-items: center; justify-content: space-evenly;">
                            <ui:VisualElement name="FunctionsList" class="recent-activity-content">
                                <ui:Label name="Function1" text="test" class="recent-activity-item" />
                                <ui:Label name="Function2" text="TwinNexus-UserManagement" class="recent-activity-item" />
                            </ui:VisualElement>
                            <ui:Button name="RefreshFunctionsButton" text="Refresh Functions" class="device-nav-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="MainBottomRow" class="main-bottom-row">
                    <ui:VisualElement name="FunctionManagementPanel" class="widget-panel system-status-panel">
                        <ui:VisualElement name="FunctionManagementHeader" class="widget-header">
                            <ui:Label name="FunctionManagementTitle" text="Function Management" class="widget-title" />
                        </ui:VisualElement>
                        <ui:VisualElement name="FunctionManagementContent" class="widget-content" style="align-items: center;">
                            <ui:Button name="ListFunctionsButton" text="List Available Functions" class="device-nav-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="TestPanel" class="widget-panel">
                        <ui:VisualElement name="TestHeader" class="widget-header">
                            <ui:Label name="TestTitle" text="Test Lambda Connection" class="widget-title" />
                        </ui:VisualElement>
                        <ui:VisualElement name="TestContent" class="widget-content" style="align-items: center;">
                            <ui:Button name="TestConnectionButton" text="Test Connectivity" class="device-nav-button" />
                            <ui:Button name="EnableDisableServiceButton" text="Enable/Disable Service" class="device-nav-button" />
                            <ui:Label name="TestResult" text="Result: Not tested" class="recent-activity-item" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Footer" class="footer">
            <ui:VisualElement name="SparePanel0" class="footer-panel">
                <ui:Label name="SpareLabel0" class="footer-label" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel1" class="footer-panel">
                <ui:Label name="SpareLabel1" class="footer-label" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel2" class="footer-panel">
                <ui:Label name="SpareLabel2" class="footer-label" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel3" class="footer-panel">
                <ui:Label name="SpareLabel3" class="footer-label" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SubpanelsAndSmokeMaskContainer" class="overlay-container">
            <ui:VisualElement name="CodeRain" class="code-rain" />
            <ui:VisualElement name="Scrim" class="ScrimTransparent" />
            <ui:VisualElement name="NavigationMenuPanel" class="NavigationMenuPanelOutMainScreen">
                <ui:VisualElement name="NavigationMenu" class="navigation-menu">
                    <ui:VisualElement class="nav-menu-header">
                        <ui:VisualElement class="nav-username-container">
                            <ui:Label text="Main Menu" class="nav-username" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="nav-menu-content">
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Dashboard" class="nav-button nav-button-active" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement name="TrainingButton" class="nav-button-container">
                                <ui:Button name="TrainingButton" text="Training" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Operations" name="OperationsButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Reports" name="ReportsButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Support" name="SupportButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Settings" name="SettingsButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-button-container">
                                <ui:Button text="Logout" name="LogoutButton" class="nav-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="nav-menu-row">
                            <ui:VisualElement class="nav-spacer-left" />
                            <ui:VisualElement class="nav-spacer-right">
                                <ui:Label name="Label" class="nav-spacer-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="HideMenuButton" class="hide-menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
