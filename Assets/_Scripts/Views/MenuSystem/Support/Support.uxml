<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Scripts/Views/MenuSystem/Support/Support.uss?fileID=7433441132597879392&amp;guid=303a84dff6fc04336919bfe3eddc20fc&amp;type=3#Support" />
    <ui:VisualElement name="Body" class="body">
        <ui:VisualElement name="Header" class="header">
            <ui:VisualElement name="MenuPanel" class="menu-panel">
                <ui:Button name="MenuButton" text="Menu" class="menu-button" />
            </ui:VisualElement>
            <ui:VisualElement name="PonerAlgo" class="spare-header-panel">
                <ui:Label name="SpareLabel0" text="Support Center" class="spare-header-label" />
            </ui:VisualElement>
            <ui:VisualElement name="UsernamePanel" class="username-panel">
                <ui:Label name="Username" class="username-label" />
            </ui:VisualElement>
            <ui:VisualElement name="LogoutPanel" class="logout-panel">
                <ui:Label name="Logout" class="logout-label" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Main" class="main">
            <ui:VisualElement name="SupportContent" class="support-content">
                <!-- Support Categories Row -->
                <ui:VisualElement class="support-row">
                    <ui:VisualElement name="TechnicalSupportPanel" class="support-panel">
                        <ui:VisualElement class="support-header">
                            <ui:Label text="📞 Technical Support" class="support-title" />
                        </ui:VisualElement>
                        <ui:VisualElement class="support-body">
                            <ui:Label text="Get help with device connectivity, troubleshooting, and technical issues" class="support-description" />
                            <ui:Button name="TechnicalSupportButton" text="Contact Technical Team" class="support-button" />
                            <ui:Label text="Response time: 2-4 hours" class="support-info" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="DocumentationPanel" class="support-panel">
                        <ui:VisualElement class="support-header">
                            <ui:Label text="📚 Documentation" class="support-title" />
                        </ui:VisualElement>
                        <ui:VisualElement class="support-body">
                            <ui:Label text="Access user manuals, API documentation, and setup guides" class="support-description" />
                            <ui:Button name="DocumentationButton" text="Browse Documentation" class="support-button" />
                            <ui:Label text="Available 24/7" class="support-info" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- Support Tools Row -->
                <ui:VisualElement class="support-row">
                    <ui:VisualElement name="SystemDiagnosticsPanel" class="support-panel">
                        <ui:VisualElement class="support-header">
                            <ui:Label text="🔧 System Diagnostics" class="support-title" />
                        </ui:VisualElement>
                        <ui:VisualElement class="support-body">
                            <ui:Label text="Run automated diagnostics and generate system reports" class="support-description" />
                            <ui:Button name="DiagnosticsButton" text="Run Diagnostics" class="support-button" />
                            <ui:Label text="Last run: Never" name="LastDiagnosticLabel" class="support-info" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="RemoteAssistancePanel" class="support-panel">
                        <ui:VisualElement class="support-header">
                            <ui:Label text="🖥️ Remote Assistance" class="support-title" />
                        </ui:VisualElement>
                        <ui:VisualElement class="support-body">
                            <ui:Label text="Allow support team to remotely access your system for assistance" class="support-description" />
                            <ui:Button name="RemoteAssistanceButton" text="Request Remote Support" class="support-button" />
                            <ui:Label text="Secure connection required" class="support-info" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- Contact & Status Row -->
                <ui:VisualElement class="support-row">
                    <ui:VisualElement name="ContactInfoPanel" class="support-panel contact-panel">
                        <ui:VisualElement class="support-header">
                            <ui:Label text="📧 Contact Information" class="support-title" />
                        </ui:VisualElement>
                        <ui:VisualElement class="support-body">
                            <ui:VisualElement class="contact-row">
                                <ui:Label text="Emergency Support:" class="contact-label" />
                                <ui:Label text="+1-800-SUPPORT" class="contact-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="contact-row">
                                <ui:Label text="General Support:" class="contact-label" />
                                <ui:Label text="support@twinnexus.com" class="contact-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="contact-row">
                                <ui:Label text="Business Hours:" class="contact-label" />
                                <ui:Label text="Mon-Fri 8AM-6PM EST" class="contact-value" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="SupportStatusPanel" class="support-panel status-panel">
                        <ui:VisualElement class="support-header">
                            <ui:Label text="📊 Support Status" class="support-title" />
                        </ui:VisualElement>
                        <ui:VisualElement class="support-body">
                            <ui:VisualElement class="status-row">
                                <ui:Label text="System Status:" class="status-label" />
                                <ui:Label text="All systems operational" class="status-online" />
                            </ui:VisualElement>
                            <ui:VisualElement class="status-row">
                                <ui:Label text="Support Queue:" class="status-label" />
                                <ui:Label text="Low volume" class="status-normal" />
                            </ui:VisualElement>
                            <ui:VisualElement class="status-row">
                                <ui:Label text="Open Tickets:" class="status-label" />
                                <ui:Label text="0" name="OpenTicketsLabel" class="status-value" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Footer" class="footer">
            <ui:VisualElement name="SparePanel0" class="footer-panel">
                <ui:Label name="SpareLabel0" class="footer-label" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel1" class="footer-panel">
                <ui:Label name="SpareLabel1" class="footer-label" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel2" class="footer-panel">
                <ui:Label name="SpareLabel2" class="footer-label" />
            </ui:VisualElement>
            <ui:VisualElement name="SparePanel3" class="footer-panel">
                <ui:Label name="SpareLabel3" class="footer-label" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SubpanelsAndSmokeMaskContainer" class="overlay-container">
    <ui:VisualElement name="CodeRain" class="code-rain" />
    <ui:VisualElement name="Scrim" class="ScrimTransparent" />
    <ui:VisualElement name="NavigationMenuPanel" class="NavigationMenuPanelOutMainScreen">
        <ui:VisualElement name="NavigationMenu" class="navigation-menu">
            <ui:VisualElement class="nav-menu-header">
                <ui:VisualElement class="nav-username-container">
                    <ui:Label text="Main Menu" class="nav-username" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="nav-menu-content">
                <ui:VisualElement class="nav-menu-row">
                    <ui:VisualElement class="nav-button-container">
                        <ui:Button text="Dashboard" name="DashboardButton" class="nav-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="nav-menu-row">
                    <ui:VisualElement name="TrainingButton" class="nav-button-container">
                        <ui:Button name="TrainingButton" text="Training" class="nav-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="nav-menu-row">
                    <ui:VisualElement class="nav-button-container">
                        <ui:Button text="Operations" name="OperationsButton" class="nav-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="nav-menu-row">
                    <ui:VisualElement class="nav-button-container">
                        <ui:Button text="Reports" name="ReportsButton" class="nav-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="nav-menu-row">
                    <ui:VisualElement class="nav-button-container">
                        <ui:Button text="Support" class="nav-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="nav-menu-row">
                    <ui:VisualElement class="nav-button-container">
                        <ui:Button text="Settings" name="SettingsButton" class="nav-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="nav-menu-row">
                    <ui:VisualElement class="nav-button-container">
                        <ui:Button text="Logout" name="LogoutButton" class="nav-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="nav-menu-row">
                    <ui:VisualElement class="nav-spacer-left" />
                    <ui:VisualElement class="nav-spacer-right">
                        <ui:Label name="Label" class="nav-spacer-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="HideMenuButton" class="hide-menu-button" />
    </ui:VisualElement>
</ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>