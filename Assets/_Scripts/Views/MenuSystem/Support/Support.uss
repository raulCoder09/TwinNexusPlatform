/* Transition classes */
.ScrimTransparent {
    flex-grow: 1;
    position: relative;
    display: flex;
    background-color: rgba(0, 0, 0, 0.78);
    transition-duration: 1s;
    opacity: 0;
}

.ScrimOpaque {
    background-color: rgba(0, 0, 0, 0.78);
    opacity: 1;
}

.NavigationMenuPanelOutMainScreen {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: row;
    translate: -100% 0;
    transition-duration: 1s;
    transition-timing-function: ease-in-cubic;
}

.NavigationMenuPanelInMainScreen {
    translate: 0% 0;
}

/* Body */
.body {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    align-self: stretch;
    align-content: stretch;
    background-color: rgb(0, 0, 0);
    background-image: url("project://database/Assets/_Images/Backgrounds/scanlines2.jpg?fileID=2800000&guid=db31ce936e2104caba450d7ddc5ce66f&type=3#scanlines2");
    background-size: 100% 4px;
    background-repeat: repeat-y;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.sergey-kotenev {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/_Images/Backgrounds/sergey-kotenev--gWSFS8rrVg-unsplash.jpg");
    background-size: 100% 100%;
    background-repeat: repeat;
    opacity: 0.30;
    z-index: -1;
}

.code-rain {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/_Images/Backgrounds/ekaterina-novitskaya-gLroHoWh_as-unsplash.jpg");
    background-size: 100% 100%;
    background-repeat: repeat;
    opacity: 0.15;
    z-index: -1;
}

/* Header */
.header {
    flex-grow: 1;
    width: 100%;
    height: 10%;
    flex-direction: row;
}

.menu-panel {
    flex-grow: 1;
    width: 25%;
    height: 100%;
    align-items: center;
}

.menu-button {
    height: 100%;
    width: 50%;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    translate: 0 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-left-color: rgb(3, 255, 0);
    border-right-color: rgb(3, 255, 0);
    border-top-color: rgb(3, 255, 0);
    border-bottom-color: rgb(3, 255, 0);
    color: rgb(4, 201, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 30px;
}

.spare-header-panel {
    flex-grow: 1;
    width: 25%;
    height: 100%;
    justify-content: center;
}

.spare-header-label {
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-text-align: upper-center;
}

.username-panel {
    flex-grow: 1;
    width: 25%;
    height: 100%;
    -unity-text-align: upper-left;
    justify-content: center;
}

.username-label {
    -unity-font-style: bold;
    -unity-text-outline-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 30px;
}

.logout-panel {
    flex-grow: 1;
    width: 25%;
    height: 100%;
    justify-content: center;
}

.logout-label {
    color: rgb(255, 255, 255);
    -unity-text-align: upper-center;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}

/* Main */
.main {
    flex-grow: 1;
    width: 100%;
    height: 80%;
    justify-content: center;
    align-items: center;
    align-self: center;
    align-content: center;
}

/* Support Content */
.support-content {
    width: 90%;
    height: 90%;
    justify-content: space-evenly;
    align-items: center;
    align-self: center;
    align-content: center;
}

.support-row {
    flex-grow: 1;
    flex-direction: row;
    width: 100%;
    height: 30%;
    justify-content: space-evenly;
    align-items: stretch;
    align-content: center;
    margin-top: 10px;
    margin-bottom: 10px;
}

/* Support Panels */
.support-panel {
    flex-grow: 1;
    width: 45%;
    height: 100%;
    margin-left: 10px;
    margin-right: 10px;
    padding: 20px;
    background-color: rgba(0, 0, 0, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    transition-duration: 0.3s;
    transition-property: background-color, border-color;
}

.support-panel:hover {
    background-color: rgba(0, 255, 0, 0.05);
    border-left-color: rgb(0, 255, 100);
    border-right-color: rgb(0, 255, 100);
    border-top-color: rgb(0, 255, 100);
    border-bottom-color: rgb(0, 255, 100);
}

.support-header {
    flex-grow: 1;
    width: 100%;
    height: 30%;
    justify-content: center;
    align-items: center;
    margin-bottom: 10px;
}

.support-title {
    color: rgb(0, 255, 0);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}

.support-body {
    flex-grow: 1;
    width: 100%;
    height: 70%;
    justify-content: space-evenly;
    align-items: center;
}

.support-description {
    color: rgb(200, 200, 200);
    font-size: 20px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    white-space: normal;
    margin-bottom: 15px;
}

.support-button {
    width: 80%;
    height: 30%;
    color: rgb(0, 255, 0);
    background-color: rgb(0, 0, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-top-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 24px;
    -unity-font-style: bold;
    transition-duration: 0.2s;
    transition-property: background-color, color;
    margin-bottom: 10px;
}

.support-button:hover {
    background-color: rgb(0, 255, 0);
    color: rgb(0, 0, 0);
}

.support-button:active {
    background-color: rgb(0, 200, 0);
    color: rgb(0, 0, 0);
}

.support-info {
    color: rgb(150, 150, 150);
    font-size: 16px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    -unity-font-style: italic;
}

/* Contact Panel Specific Styles */
.contact-panel .support-body {
    justify-content: space-around;
}

.contact-row {
    flex-grow: 1;
    flex-direction: row;
    width: 100%;
    height: 25%;
    justify-content: space-between;
    align-items: center;
    margin-top: 5px;
    margin-bottom: 5px;
}

.contact-label {
    color: rgb(200, 200, 200);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    width: 50%;
}

.contact-value {
    color: rgb(0, 255, 0);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    width: 50%;
    -unity-text-align: middle-right;
}

/* Status Panel Specific Styles */
.status-panel .support-body {
    justify-content: space-around;
}

.status-row {
    flex-grow: 1;
    flex-direction: row;
    width: 100%;
    height: 25%;
    justify-content: space-between;
    align-items: center;
    margin-top: 5px;
    margin-bottom: 5px;
}

.status-label {
    color: rgb(200, 200, 200);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    width: 60%;
}

.status-online {
    color: rgb(0, 255, 0);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    width: 40%;
    -unity-text-align: middle-right;
}

.status-normal {
    color: rgb(255, 255, 0);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    width: 40%;
    -unity-text-align: middle-right;
}

.status-value {
    color: rgb(0, 255, 0);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    width: 40%;
    -unity-text-align: middle-right;
}

/* Footer */
.footer {
    flex-grow: 1;
    width: 100%;
    height: 10%;
    flex-direction: row;
}

.footer-panel {
    flex-grow: 1;
    width: 25%;
    height: 100%;
    justify-content: center;
}

.footer-label {
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-text-align: upper-center;
}

/* Overlay and navigation menu */
.overlay-container {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    opacity: 1;
}

.navigation-menu {
    flex-grow: 1;
    position: relative;
    width: 25%;
    height: 100%;
    translate: 0 0;
    background-color: rgb(0, 0, 0);
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}

.nav-menu-header {
    flex-grow: 1;
    width: 100%;
    height: 30%;
}

.nav-username-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 25%;
    margin-top: 0;
    margin-left: 0;
}

.nav-username {
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    -unity-font-style: bold;
    font-size: 50px;
    color: rgb(0, 255, 0);
}

.nav-menu-content {
    flex-grow: 1;
    width: 100%;
    height: 70%;
}

.nav-menu-row {
    flex-grow: 1;
    flex-direction: row;
}

.nav-button-container {
    flex-grow: 1;
    width: 80%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.nav-button {
    font-size: 40px;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    color: rgb(0, 255, 0);
    -unity-font-style: bold;
    background-color: rgba(188, 188, 188, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.nav-button-active {
    color: rgb(255, 172, 51);
}

.nav-spacer-left {
    flex-grow: 1;
    width: 20%;
    height: 100%;
}

.nav-spacer-right {
    flex-grow: 1;
    width: 80%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.nav-spacer-label {
    -unity-font-style: bold;
    font-size: 30px;
}

.hide-menu-button {
    width: 75%;
    height: 100%;
    background-color: rgba(188, 188, 188, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}