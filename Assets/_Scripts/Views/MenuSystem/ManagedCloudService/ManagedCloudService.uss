/* Estilos de transición existentes */
.NavigationMenuPanelOutMainScreen {
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: row;
    translate: -100% 0;
    transition-duration: 1s;
    transition-timing-function: ease-in-cubic;
}
.code-rain {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/_Images/Backgrounds/ekaterina-novitskaya-gLroHoWh_as-unsplash.jpg");
    background-size: 100% 100%;
    background-repeat: repeat;
    opacity: 0.15;
    z-index: -1;
}
.NavigationMenuPanelInMainScreen {
    translate: 0% 0;
}

.ScrimTransparent {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition-duration: 1s;
}

.ScrimOpaque {
    opacity: 1;
    background-color: rgba(0, 0, 0, 0.78);
}

/* Estados activos para menú lateral */
.navigation-menu-button-active {
    color: rgb(255, 172, 51) !important;
}

/* Body principal */
#Body {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    align-self: stretch;
    align-content: stretch;
    background-color: rgb(0, 0, 0);
    background-image: url("project://database/Assets/_Images/Backgrounds/scanlines2.jpg?fileID=2800000&guid=db31ce936e2104caba450d7ddc5ce66f&type=3#scanlines2");
    background-size: 100% 4px;
    background-repeat: repeat-y;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

/* Header */
#Header {
    flex-grow: 1;
    width: 100%;
    height: 10%;
    flex-direction: row;
}

#MenuPanel {
    flex-grow: 1;
    width: 25%;
    height: 100%;
    align-items: center;
}

#MenuButton {
    height: 100%;
    width: 50%;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    translate: 0 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-left-color: rgb(3, 255, 0);
    border-right-color: rgb(3, 255, 0);
    border-top-color: rgb(3, 255, 0);
    border-bottom-color: rgb(3, 255, 0);
    color: rgb(4, 201, 0);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 30px;
}

#TitlePanel {
    flex-grow: 1;
    width: 50%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.selected-mode-ui-name {
    color: rgb(3, 255, 0);
    font-size: 40px;
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    -unity-font-style: bold;
}

#UsernamePanel {
    flex-grow: 1;
    width: 25%;
    height: 100%;
    -unity-text-align: upper-left;
    justify-content: center;
}

#Username {
    -unity-font-style: bold;
    -unity-text-outline-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    font-size: 30px;
}

#LogoutPanel {
    flex-grow: 1;
    width: 25%;
    height: 100%;
    justify-content: center;
}

#Logout {
    color: rgb(255, 255, 255);
    -unity-text-align: upper-center;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}

/* Main */
#Main {
    flex-grow: 1;
    width: 100%;
    height: 80%;
    justify-content: center;
    align-items: center;
    align-self: center;
    align-content: center;
}

/* Footer */
#Footer {
    flex-grow: 1;
    width: 100%;
    height: 10%;
    flex-direction: row;
}

#SparePanel0, #SparePanel1, #SparePanel2, #SparePanel3 {
    flex-grow: 1;
    width: 25%;
    height: 100%;
    justify-content: center;
}

#SparePanel0 #SpareLabel0,
#SparePanel1 #SpareLabel1,
#SparePanel2 #SpareLabel2,
#SparePanel3 #SpareLabel3 {
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-text-align: upper-center;
}

/* Subpanels Container */
#SubpanelsAndSmokeMaskContainer {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    opacity: 1;
}

/* Navigation Menu */
#NavigationMenu {
    flex-grow: 1;
    position: relative;
    width: 25%;
    height: 100%;
    translate: 0% 0;
    background-color: rgb(0, 0, 0);
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}

/* Navigation Menu Header */
.nav-header {
    flex-grow: 1;
    width: 100%;
    height: 30%;
}

.nav-username-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 25%;
    margin-top: 0;
    margin-left: 0;
}

.nav-username-label {
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    -unity-font-style: bold;
    font-size: 50px;
    color: rgb(0, 255, 0);
}

/* Navigation Menu Body */
.nav-body {
    flex-grow: 1;
    width: 100%;
    height: 70%;
}

.nav-row {
    flex-grow: 1;
    flex-direction: row;
}

.nav-button-container {
    flex-grow: 1;
    width: 80%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.nav-button {
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    -unity-font-style: bold;
    font-size: 40px;
    color: rgb(0, 255, 0);
    background-color: rgba(188, 188, 188, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.nav-spacer-container {
    flex-grow: 1;
    width: 20%;
    height: 100%;
}

.nav-spacer {
    flex-grow: 1;
    width: 50%;
    height: 50%;
}

.nav-label-container {
    flex-grow: 1;
    width: 80%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.nav-label {
    -unity-font-style: bold;
    font-size: 30px;
}

/* Settings Button específico */
#SettingsButton {
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
}

/* Hide Menu Button */
#HideMenuButton {
    width: 75%;
    height: 100%;
    background-color: rgba(188, 188, 188, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

/* === ESTILOS ESPECÍFICOS PARA AWS IOT CORE MQTT === */

/* MQTT Dashboard Container */
.mqtt-dashboard-container {
    width: 95%;
    height: 95%;
    padding: 20px;
    justify-content: space-between;
    align-items: stretch;
}

.dashboard-row {
    flex-direction: row;
    width: 100%;
    height: 30%;
    margin-bottom: 15px;
    justify-content: space-between;
    align-items: stretch;
}

.dashboard-row-tall {
    height: 35%;
}

/* Panel Base Styles */
.connection-panel, .metrics-panel, .controls-panel, .topic-panel, .data-stream-panel {
    flex-grow: 1;
    margin-left: 10px;
    margin-right: 10px;
    background-color: rgba(0, 0, 0, 0.7);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 152, 255);
    border-right-color: rgb(0, 152, 255);
    border-top-color: rgb(0, 152, 255);
    border-bottom-color: rgb(0, 152, 255);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    padding: 15px;
}

.panel-header {
    height: 15%;
    margin-bottom: 10px;
    justify-content: center;
    align-items: flex-start;
}

.panel-title {
    color: rgb(0, 152, 255);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}

/* Connection Status Panel */
.connection-details {
    height: 85%;
    justify-content: space-around;
    align-items: stretch;
}

.endpoint-info, .connection-status, .certificate-info {
    flex-grow: 1;
    padding: 10px;
    background-color: rgba(0, 100, 150, 0.2);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    margin: 5px 0;
    justify-content: center;
}

.info-label {
    font-size: 14px;
    color: rgb(150, 200, 255);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    margin-bottom: 5px;
}

.endpoint-address {
    font-size: 16px;
    color: rgb(100, 200, 255);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}

.status-connected, .security-status {
    font-size: 18px;
    color: rgb(0, 255, 150);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}

.client-info, .cert-label {
    font-size: 14px;
    color: rgb(200, 200, 200);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}

/* MQTT Metrics Panel */
.metrics-grid {
    height: 85%;
    justify-content: space-around;
    align-items: stretch;
}

.metric-box {
    flex-grow: 1;
    margin: 5px;
    padding: 15px;
    background-color: rgba(0, 152, 255, 0.1);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    justify-content: center;
    align-items: center;
}

.metric-label {
    font-size: 14px;
    color: rgb(180, 180, 180);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.metric-value {
    font-size: 24px;
    color: rgb(0, 255, 200);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    -unity-text-align: middle-center;
}

/* MQTT Controls Panel */
.controls-grid {
    height: 85%;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
}

.mqtt-button {
    flex-grow: 1;
    height: 80%;
    margin: 0 5px;
    background-color: rgba(0, 0, 0, 0.8);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    transition-duration: 0.3s;
    transition-property: background-color, border-color, scale;
    justify-content: center;
    align-items: center;
    flex-direction: column;
}

.connect-button {
    border-left-color: rgb(0, 255, 100);
    border-right-color: rgb(0, 255, 100);
    border-top-color: rgb(0, 255, 100);
    border-bottom-color: rgb(0, 255, 100);
}

.disconnect-button {
    border-left-color: rgb(255, 70, 70);
    border-right-color: rgb(255, 70, 70);
    border-top-color: rgb(255, 70, 70);
    border-bottom-color: rgb(255, 70, 70);
}

.publish-button {
    border-left-color: rgb(0, 152, 255);
    border-right-color: rgb(0, 152, 255);
    border-top-color: rgb(0, 152, 255);
    border-bottom-color: rgb(0, 152, 255);
}

.subscribe-button {
    border-left-color: rgb(255, 165, 0);
    border-right-color: rgb(255, 165, 0);
    border-top-color: rgb(255, 165, 0);
    border-bottom-color: rgb(255, 165, 0);
}

.mqtt-button:hover {
    scale: 1.05;
    background-color: rgba(255, 255, 255, 0.1);
}

.mqtt-button:active {
    scale: 0.95;
}

.button-icon {
    font-size: 30px;
    margin-bottom: 5px;
}

.button-label {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}

.connect-button .button-icon, .connect-button .button-label { color: rgb(0, 255, 100); }
.disconnect-button .button-icon, .disconnect-button .button-label { color: rgb(255, 70, 70); }
.publish-button .button-icon, .publish-button .button-label { color: rgb(0, 152, 255); }
.subscribe-button .button-icon, .subscribe-button .button-label { color: rgb(255, 165, 0); }

/* Topic Configuration Panel */
.topic-config {
    height: 85%;
    justify-content: space-around;
}

.input-group {
    flex-grow: 1;
    margin: 8px 0;
}

.input-label {
    font-size: 14px;
    color: rgb(0, 200, 255);
    -unity-font-style: bold;
    margin-bottom: 5px;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}

.topic-field, .message-field {
    background-color: rgba(0, 50, 100, 0.3);
    border-left-width: 2px;
    border-left-color: rgb(0, 152, 255);
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    padding: 8px;
}

.message-field {
    height: 60px;
}

.qos-dropdown {
    background-color: rgba(0, 50, 100, 0.3);
    border-left-width: 2px;
    border-left-color: rgb(0, 152, 255);
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}

/* Real-time Data Stream Panel */
.data-stream-scroll {
    height: 85%;
    background-color: rgba(0, 20, 40, 0.5);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    padding: 10px;
}

.data-item {
    margin: 8px 0;
    padding: 12px;
    background-color: rgba(0, 50, 100, 0.3);
    border-left-width: 3px;
    border-left-color: rgb(0, 255, 200);
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
    transition-duration: 0.2s;
    transition-property: background-color, border-color;
}

.data-item:hover {
    background-color: rgba(0, 80, 150, 0.4);
    border-left-color: rgb(100, 255, 255);
}

.data-topic {
    font-size: 14px;
    color: rgb(150, 200, 255);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    margin-bottom: 5px;
}

.data-payload {
    font-size: 12px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
    white-space: normal;
    margin-bottom: 3px;
}

.data-timestamp {
    font-size: 10px;
    color: rgb(120, 120, 120);
    -unity-text-align: upper-right;
    -unity-font-definition: url("project://database/Assets/_Fonts/References/VT323-Regular.ttf?fileID=12800000&guid=289b75764e32a4b85b2ee0c973db7173&type=3#VT323-Regular");
}